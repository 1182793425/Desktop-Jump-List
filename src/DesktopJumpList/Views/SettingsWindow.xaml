<Window x:Class="DesktopJumpList.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jump 设置" Width="620" Height="852"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        Foreground="{DynamicResource InkBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColorDot" TargetType="RadioButton">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="26" Height="26">
                            <Ellipse Width="20" Height="20" Fill="{TemplateBinding Background}"
                                     Stroke="#2A000000" StrokeThickness="1" />
                            <Ellipse x:Name="Ring" Width="26" Height="26"
                                     Stroke="{DynamicResource InkBrush}" StrokeThickness="1.6" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="SettingsSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkSubBrush}" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>
        <!-- One settings row: a fixed label gutter plus a control area. Every row shares the same
             height so the label, the switch and the value boxes sit on one optical line. -->
        <Style x:Key="SettingsRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource SettingsLabel}">
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <!-- Trailing description: sits right next to the control it explains, same line. -->
        <Style x:Key="InlineHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource InkSubBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <!-- Label inside a multi-column grid: hugs the box on its right so the value always reads
             as part of its own pair, even when the neighbouring label is shorter. -->
        <Style x:Key="GridLabel" TargetType="TextBlock" BasedOn="{StaticResource RowLabel}">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="SettingsNumber" TargetType="TextBox">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="26" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource SegmentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <EventSetter Event="LostFocus" Handler="OnNumberLostFocus" />
            <EventSetter Event="PreviewKeyDown" Handler="OnNumberKeyDown" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsSlider" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource PanelOpaqueBrush}"
                                                         Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource ToggleTrackBrush}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Border CornerRadius="22" Background="{DynamicResource PanelOpaqueBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270"
                                  Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="24,18,24,8">
                    <TextBlock Text="设置" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="SettingsDone" Content="完成" Style="{StaticResource LinkButton}"
                            HorizontalAlignment="Right" FontWeight="SemiBold" Click="OnSettingsDone" />
                </Grid>

                <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" Margin="20,0,14,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel Margin="0,0,4,0">

                        <!-- 外观 -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="外观" Style="{StaticResource SettingsSection}" />
                                <Grid Style="{StaticResource SettingsRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="主题" Style="{StaticResource RowLabel}" />
                                    <Border Grid.Column="1" HorizontalAlignment="Left" CornerRadius="10" Padding="3"
                                            Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <ToggleButton x:Name="ThemeSystem" Style="{StaticResource SegmentButton}"
                                                          Content="跟随系统" Click="OnThemeSystem" />
                                            <ToggleButton x:Name="ThemeLight" Style="{StaticResource SegmentButton}"
                                                          Content="浅色" Margin="2,0" Click="OnThemeLight" />
                                            <ToggleButton x:Name="ThemeDark" Style="{StaticResource SegmentButton}"
                                                          Content="深色" Click="OnThemeDark" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid Style="{StaticResource SettingsRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="面板透明度" Style="{StaticResource RowLabel}" />
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="18" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="OpacitySlider" Style="{StaticResource SettingsSlider}"
                                                Minimum="0" Maximum="100" Value="85"
                                                IsSnapToTickEnabled="True" TickFrequency="1"
                                                ValueChanged="OnOpacityChanged" />
                                        <TextBox x:Name="OpacityBox" Grid.Column="1" Style="{StaticResource SettingsNumber}"
                                                 Text="85" Margin="10,0,0,0" />
                                        <TextBlock Grid.Column="2" Text="%" Style="{StaticResource Unit}" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 布局与面板 -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="布局与面板" Style="{StaticResource SettingsSection}" />
                                <!-- Six short values fit on two rows; the columns are shared between the
                                     rows so「每行」and「图标」line up with their own boxes. -->
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="每行" Style="{StaticResource GridLabel}" />
                                    <TextBox x:Name="ColumnsBox" Grid.Column="1" Style="{StaticResource SettingsNumber}"
                                             Margin="0,3,0,3" />
                                    <TextBlock Grid.Column="3" Text="最大行数" Style="{StaticResource GridLabel}" />
                                    <TextBox x:Name="RowsBox" Grid.Column="4" Style="{StaticResource SettingsNumber}"
                                             Margin="0,3,0,3" />
                                    <TextBlock Grid.Column="6" Text="最近使用" Style="{StaticResource GridLabel}" />
                                    <TextBox x:Name="RecentBox" Grid.Column="7" Style="{StaticResource SettingsNumber}"
                                             Margin="0,3,0,3" />

                                    <TextBlock Grid.Row="1" Text="图标" Style="{StaticResource GridLabel}" />
                                    <TextBox x:Name="IconBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsNumber}"
                                             Margin="0,3,0,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="文字" Style="{StaticResource GridLabel}" />
                                    <TextBox x:Name="FontBox" Grid.Row="1" Grid.Column="4" Style="{StaticResource SettingsNumber}"
                                             Margin="0,3,0,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="6" Text="项间距" Style="{StaticResource GridLabel}" />
                                    <TextBox x:Name="ItemGapBox" Grid.Row="1" Grid.Column="7" Style="{StaticResource SettingsNumber}"
                                             Margin="0,3,0,3" />

                                    <!-- The two gaps side by side, each named for what it actually separates. -->
                                    <TextBlock Grid.Row="2" Text="图标与文字" Style="{StaticResource GridLabel}" Margin="0,0,6,0" />
                                    <TextBox x:Name="GapBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource SettingsNumber}"
                                             Margin="0,3,0,3" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="6"
                                               Style="{StaticResource InlineHint}" VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Text="图标与它下面文字的距离；「项间距」是图标之间、行之间的空隙" />
                                </Grid>
                                <TextBlock Style="{StaticResource InlineHint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="面板宽高由每行数量、图标大小、项间距撑开；行数按「最大行数」铺开，超出屏幕才滚动" />
                            </StackPanel>
                        </Border>

                        <!-- 悬浮球 -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="悬浮球" Style="{StaticResource SettingsSection}" />
                                <Grid Style="{StaticResource SettingsRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="显示" Style="{StaticResource RowLabel}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="DockVisibleSwitch" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center" Click="OnDockVisibleClick" />
                                        <TextBlock Style="{StaticResource InlineHint}" Text="在屏幕边缘显示可拖动的圆点" />
                                    </StackPanel>
                                </Grid>

                                <Grid Style="{StaticResource SettingsRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="自动收起" Style="{StaticResource RowLabel}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox x:Name="PeekBox" Style="{StaticResource SettingsNumber}" Width="60" />
                                        <TextBlock Text="秒" Style="{StaticResource Unit}" />
                                        <TextBlock Style="{StaticResource InlineHint}" Text="后缩成贴边细条" />
                                    </StackPanel>
                                </Grid>

                                <Grid Style="{StaticResource SettingsRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="大小" Style="{StaticResource RowLabel}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox x:Name="DockSizeBox" Style="{StaticResource SettingsNumber}" />
                                        <TextBlock Text="px" Style="{StaticResource Unit}" />
                                        <TextBlock Text="吸附距离" Style="{StaticResource RowLabel}" Margin="24,0,0,0" />
                                        <TextBox x:Name="SnapBox" Style="{StaticResource SettingsNumber}" Margin="8,0,0,0" />
                                        <TextBlock Text="px" Style="{StaticResource Unit}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Style="{StaticResource SettingsRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="圆点颜色" Style="{StaticResource RowLabel}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="ColorWhite" Style="{StaticResource ColorDot}" Background="#FFFFFF"
                                                     Tag="#FFFFFF" GroupName="DockColor" Checked="OnDockColorChecked" />
                                        <RadioButton x:Name="ColorGraphite" Style="{StaticResource ColorDot}" Background="#2B2F36"
                                                     Tag="#2B2F36" GroupName="DockColor" Checked="OnDockColorChecked" />
                                        <RadioButton x:Name="ColorGray" Style="{StaticResource ColorDot}" Background="#D1D5DB"
                                                     Tag="#D1D5DB" GroupName="DockColor" Checked="OnDockColorChecked" />
                                        <RadioButton x:Name="ColorBlue" Style="{StaticResource ColorDot}" Background="#3B82F6"
                                                     Tag="#3B82F6" GroupName="DockColor" Checked="OnDockColorChecked" />
                                        <RadioButton x:Name="ColorGreen" Style="{StaticResource ColorDot}" Background="#22C55E"
                                                     Tag="#22C55E" GroupName="DockColor" Checked="OnDockColorChecked" />
                                        <RadioButton x:Name="ColorOrange" Style="{StaticResource ColorDot}" Background="#F59E0B"
                                                     Tag="#F59E0B" GroupName="DockColor" Checked="OnDockColorChecked" />
                                        <RadioButton x:Name="ColorRose" Style="{StaticResource ColorDot}" Background="#F43F5E"
                                                     Tag="#F43F5E" GroupName="DockColor" Checked="OnDockColorChecked" />
                                        <Button x:Name="CustomColorButton" Style="{StaticResource LinkButton}"
                                                Click="OnCustomColorClick" Padding="6,2" Margin="4,0,0,0"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="CustomColorSwatch" Width="14" Height="14" CornerRadius="7"
                                                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" />
                                                <TextBlock Text="自定义…" FontSize="11.5" Margin="6,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Style="{StaticResource SettingsRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="不透明度" Style="{StaticResource RowLabel}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox x:Name="DockOpacityBox" Style="{StaticResource SettingsNumber}" />
                                        <TextBlock Text="%" Style="{StaticResource Unit}" />
                                        <TextBlock Text="圆角" Style="{StaticResource RowLabel}" Margin="24,0,0,0" />
                                        <TextBox x:Name="DockRadiusBox" Style="{StaticResource SettingsNumber}" Margin="8,0,0,0" />
                                        <TextBlock Text="px" Style="{StaticResource Unit}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 快捷键与启动 -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="快捷键与启动" Style="{StaticResource SettingsSection}" />
                                <Grid Style="{StaticResource SettingsRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="全局快捷键" Style="{StaticResource RowLabel}" />
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="HotkeySwitch" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center" Click="OnHotkeyEnabledClick" />
                                        <TextBlock Grid.Column="1" Text="启用" Style="{StaticResource RowLabel}" Margin="8,0,0,0" />
                                        <Border x:Name="HotkeyBox" Grid.Column="2" Width="150" Height="30" Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                CornerRadius="8" Background="{DynamicResource SegmentBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                Cursor="Hand" Focusable="True" FocusVisualStyle="{x:Null}"
                                                MouseLeftButtonUp="OnHotkeyBoxClick">
                                            <TextBlock x:Name="HotkeyText" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       FontSize="12" Foreground="{DynamicResource InkBrush}" />
                                        </Border>
                                        <TextBlock x:Name="HotkeyHint" Grid.Column="3" Style="{StaticResource InlineHint}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </Grid>
                                </Grid>

                                <Grid Style="{StaticResource SettingsRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="开机启动" Style="{StaticResource RowLabel}" />
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="AutostartSwitch" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center" Click="OnAutostartClick" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource InlineHint}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Text="登录 Windows 后在系统托盘静默启动" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="24,8,24,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SettingsNotice" Margin="2,0,0,6" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed" />
                    <Grid Grid.Row="1">
                        <Button x:Name="DataFolderButton" Content="打开数据目录" Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Left" Padding="0,3" Click="OnOpenDataFolder" />
                        <TextBlock x:Name="VersionText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{DynamicResource InkFaintBrush}" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
