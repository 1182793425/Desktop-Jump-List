<Window x:Class="DesktopJumpList.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 Jump" Width="640" Height="580"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        Foreground="{DynamicResource InkBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource AccentBrush}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextBlock.Foreground="#FFFFFF" TextBlock.FontWeight="SemiBold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Foreground" Value="{DynamicResource InkSubBrush}" />
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <!-- One short line under a title. Anything longer belongs in the UI itself, not in prose. -->
        <Style x:Key="StepBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource InkSubBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
        </Style>
        <Style x:Key="StepCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="DriveRow" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="12,9"
                                BorderThickness="1" BorderBrush="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Checked state: accent box + white tick. A white tick on the neutral
                                     grey box was invisible in the light theme, which read as "nothing
                                     is selected" even though the drive was. -->
                                <Border x:Name="Box" Width="20" Height="20" CornerRadius="6" Margin="0,0,12,0"
                                        Background="{DynamicResource SegmentBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <Path x:Name="Check" Width="10" Height="8" Stretch="Uniform"
                                          Data="M0,4 L3.5,7.5 L10,0" Stroke="#FFFFFF" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Tag}" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="RowSub" FontSize="10.5" Margin="0,1,0,0"
                                               Foreground="{DynamicResource InkFaintBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" x:Name="SizeText" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource InkFaintBrush}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Keycap: two keys and a plus stand in for the whole hotkey sentence. -->
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SegmentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,3" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="26,14" />
            <Setter Property="MinWidth" Value="86" />
        </Style>
        <Style x:Key="KeyCapText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeyCapPlus" TargetType="TextBlock">
            <Setter Property="Text" Value="+" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Round arrow for the screenshot carousel. -->
        <Style x:Key="CarouselArrow" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource InkSubBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource SegmentBrush}" CornerRadius="17"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.32" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="24" Background="{DynamicResource PanelOpaqueBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 头部：标题 + 步骤圆点 -->
            <Grid Grid.Row="0" Margin="30,24,30,10">
                <StackPanel>
                    <TextBlock x:Name="HeaderTitle" Text="欢迎使用 Jump" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderSub" Text="碰一下滑出，点一下打开" Margin="1,4,0,0"
                               FontSize="12" Foreground="{DynamicResource InkFaintBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,6,0,2">
                    <Ellipse x:Name="Dot0" Width="8" Height="8" Margin="3,0" Fill="{DynamicResource AccentBrush}" />
                    <Ellipse x:Name="Dot1" Width="8" Height="8" Margin="3,0" Fill="{DynamicResource InkFaintBrush}" />
                    <Ellipse x:Name="Dot2" Width="8" Height="8" Margin="3,0" Fill="{DynamicResource InkFaintBrush}" />
                    <Ellipse x:Name="Dot3" Width="8" Height="8" Margin="3,0" Fill="{DynamicResource InkFaintBrush}" />
                    <Ellipse x:Name="Dot4" Width="8" Height="8" Margin="3,0" Fill="{DynamicResource InkFaintBrush}" />
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="PageScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="30,6,30,0">
                <Grid>
                    <!-- 第 0 页：欢迎 -->
                    <StackPanel x:Name="PageWelcome" Visibility="Visible">
                        <TextBlock Style="{StaticResource StepTitle}" Text="一个球，装下所有常用入口" />
                        <TextBlock Style="{StaticResource StepBody}"
                                   Text="平时是屏幕边缘的一条细线，鼠标碰到就滑出面板。" />
                        <Border Style="{StaticResource StepCard}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StepBody}" LineHeight="24"
                                           Text="●  文件、文件夹、软件，点一下就开&#x0a;●  输入 wx 就能找到微信&#x0a;●  文件拖到球上就是收藏" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource StepBody}" Margin="0,2,0,0" Text="4 步配好。" />
                    </StackPanel>

                    <!-- 第 1 页：选择索引盘符 -->
                    <StackPanel x:Name="PageIndex" Visibility="Collapsed">
                        <Border Style="{StaticResource StepCard}" Margin="0,2,0,0" Padding="10,8">
                            <StackPanel x:Name="DriveList" />
                        </Border>
                        <TextBlock x:Name="IndexHint" Style="{StaticResource StepBody}" Margin="2,8,0,0" FontSize="11"
                                   Text="点下一步就开始在后台建立索引" />
                    </StackPanel>

                    <!-- 第 2 页：快捷键 -->
                    <!-- MinHeight = the scroll viewport, so the empty row below the card really is
                         the remaining space and the keycaps can sit in the middle of it. -->
                    <Grid x:Name="PageHotkey" Visibility="Collapsed"
                          MinHeight="{Binding ActualHeight, ElementName=PageScroller}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource StepCard}" Margin="0,2,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="全局快捷键" FontSize="11.5" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border x:Name="HotkeyBox" Background="{DynamicResource SegmentBrush}" CornerRadius="8"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            Padding="14,6" Cursor="Hand" MouseLeftButtonDown="OnHotkeyBoxClick"
                                            Focusable="True" KeyboardNavigation.TabNavigation="None">
                                        <TextBlock x:Name="HotkeyText" FontSize="12.5" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="启用" Margin="14,0,6,0" VerticalAlignment="Center"
                                               FontSize="11.5" Foreground="{DynamicResource InkSubBrush}" />
                                    <CheckBox x:Name="HotkeySwitch" Style="{StaticResource Switch}"
                                              VerticalAlignment="Center"
                                              Checked="OnHotkeySwitchChanged" Unchecked="OnHotkeySwitchChanged" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- 键帽图形：一眼看出是 Ctrl + ` 两个键，居中放在卡片下方的空白里 -->
                        <StackPanel x:Name="KeycapRow" Grid.Row="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock x:Name="HotkeyHint" Grid.Row="2" Style="{StaticResource StepBody}"
                                   Margin="0,0,0,2" FontSize="11"
                                   TextAlignment="Center" Text="数字 1 左边那个键 · 点键框可更换" />
                    </Grid>

                    <!-- 第 3 页：直接搜索 -->
                    <StackPanel x:Name="PagePlainSearch" Visibility="Collapsed">
                        <Border Style="{StaticResource StepCard}" Margin="0,2,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="搜索时同时找本地文件" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="推荐开启" FontSize="11"
                                               Foreground="{DynamicResource InkFaintBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="PlainSearchSwitch" Grid.Column="1" VerticalAlignment="Center"
                                          Style="{StaticResource Switch}" IsChecked="True"
                                          Checked="OnPlainSearchChanged" Unchecked="OnPlainSearchChanged" />
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource StepBody}" Margin="2,2,0,0" FontSize="11"
                                   Text="关掉后只有 /s 关键词 才找文件。" />
                    </StackPanel>

                    <!-- 第 4 页：一次一张图，左右翻看 -->
                    <StackPanel x:Name="PageTeach" Visibility="Collapsed">
                        <Border Style="{StaticResource StepCard}" Margin="0,2,0,0" Padding="18,16">
                            <StackPanel>
                                <!-- All three screenshots share one aspect ratio (padded when they
                                     were rendered), so this frame never jumps between slides. -->
                                <Image x:Name="SlideImage" Stretch="Uniform" HorizontalAlignment="Stretch"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <TranslateTransform x:Name="SlideShift" />
                                    </Image.RenderTransform>
                                </Image>
                                <TextBlock x:Name="SlideCaption" FontSize="11.5" Margin="0,8,0,0"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           Foreground="{DynamicResource InkSubBrush}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                    <Button x:Name="PrevSlideButton" Style="{StaticResource CarouselArrow}"
                                            Content="◀" Click="OnPrevSlide" ToolTip="上一张" />
                                    <StackPanel x:Name="SlideDots" Orientation="Horizontal"
                                                Margin="14,0" VerticalAlignment="Center" />
                                    <Button x:Name="NextSlideButton" Style="{StaticResource CarouselArrow}"
                                            Content="▶" Click="OnNextSlide" ToolTip="下一张" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- 底部导航 -->
            <Grid Grid.Row="2" Margin="30,10,30,22">
                <Button x:Name="BackButton" Style="{StaticResource GhostButton}" Content="← 上一步"
                        HorizontalAlignment="Left" Click="OnBackClick" />
                <Button x:Name="NextButton" Style="{StaticResource PrimaryButton}" Content="下一步 →"
                        HorizontalAlignment="Right" Click="OnNextClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
