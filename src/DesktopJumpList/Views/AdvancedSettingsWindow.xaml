<Window x:Class="DesktopJumpList.Views.AdvancedSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jump 高级设置" Width="520" Height="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        Foreground="{DynamicResource InkBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkSubBrush}" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ThinSlider" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource PanelOpaqueBrush}"
                                                         Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource ToggleTrackBrush}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Border CornerRadius="22" Background="{DynamicResource PanelOpaqueBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270"
                                  Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="24,18,24,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BackButton" Content="← 返回" Style="{StaticResource LinkButton}"
                                Padding="2,2" Margin="0,0,10,0" Click="OnClose" />
                        <TextBlock Text="高级设置" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Content="完成" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                            FontWeight="SemiBold" Click="OnClose" />
                </Grid>

                <ScrollViewer Grid.Row="1" Margin="20,4,14,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="0,0,4,0">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="搜索行为" Style="{StaticResource Section}" />
                                <Grid Margin="2,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="输入防抖" Style="{StaticResource RowLabel}" />
                                    <Slider x:Name="DebounceSlider" Grid.Column="1" Margin="12,0"
                                            Style="{StaticResource ThinSlider}" Minimum="0" Maximum="300" />
                                    <TextBlock x:Name="DebounceValue" Grid.Column="2" Width="56"
                                               TextAlignment="Right" Style="{StaticResource RowLabel}"
                                               Foreground="{DynamicResource InkSubBrush}" />
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="2,6,0,0"
                                           Text="停下输入多久后才开始搜索。0 = 每个按键都立即搜索；条目很多时建议 80–150ms。搜索框与已输入的字符永远是即时的，不受这个值影响。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="本地文件搜索 · /s 指令" Style="{StaticResource Section}" />
                                <Grid>
                                    <TextBlock Text="启用" Style="{StaticResource RowLabel}" />
                                    <CheckBox x:Name="FileSearchSwitch" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Right" Click="OnFileSearchToggled" />
                                </Grid>

                                <TextBlock x:Name="FileIndexStatus" Style="{StaticResource Hint}" Margin="2,6,0,2" />

                                <StackPanel x:Name="RootRows" Margin="0,2,0,0" />
                                <Button x:Name="AddRootButton" Content="＋ 添加文件夹…" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Left" Padding="0,4" Margin="2,4,0,0" Click="OnAddRoot" />

                                <TextBlock Style="{StaticResource Hint}" Margin="2,6,0,0" TextWrapping="Wrap"
                                           Text="在搜索框输入 /s 关键词（例如 /s 设计稿）才会检索本地文件，结果里只有本地文件，不含快捷项和网页搜索。普通搜索完全不碰磁盘，也不会触发索引。索引只在你第一次使用 /s 时后台建立，遍历你添加的文件夹（默认：桌面 / 文档 / 图片 / 下载），跳过 node_modules、.git、bin、AppData 等目录，五分钟后自动重建，最多显示 12 条。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="搜索引擎" Style="{StaticResource Section}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,8"
                                           Text="打开下面任意一项后，在面板里输入关键词时，结果末尾会多出「百度搜索」「谷歌搜索」等条目；选中回车用系统默认浏览器打开。" />
                                <StackPanel x:Name="EngineRows" />
                                <TextBlock Style="{StaticResource Hint}" Margin="2,10,0,0"
                                           Text="图标是矢量绘制的品牌色方块 + 字标，不依赖位图素材，任何缩放和 DPI 下都清晰。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="24,8,24,16">
                    <Button Content="恢复默认（百度 / 谷歌 / 必应）" Style="{StaticResource LinkButton}"
                            HorizontalAlignment="Left" Padding="0,3" FontSize="11.5" Click="OnResetDefaults" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
