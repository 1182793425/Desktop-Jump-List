<Window x:Class="DesktopJumpList.Views.AdvancedSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jump 高级设置" Width="520" Height="660"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        Foreground="{DynamicResource InkBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkSubBrush}" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ThinSlider" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource PanelOpaqueBrush}"
                                                         Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Small ⓘ next to a row: the explanation lives in its ToolTip. -->
        <Style x:Key="InfoDot" TargetType="TextBlock">
            <Setter Property="Text" Value="ⓘ" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        </Style>
        <!-- Dark rounded tooltips matching the panel instead of the yellow system ones. -->
        <Style TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource PanelOpaqueBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="12,9" MaxWidth="380">
                            <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Border CornerRadius="22" Background="{DynamicResource PanelOpaqueBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270"
                                  Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="24,18,24,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BackButton" Content="← 返回" Style="{StaticResource LinkButton}"
                                Padding="2,2" Margin="0,0,10,0" Click="OnClose" />
                        <TextBlock Text="高级设置" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Content="完成" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                            FontWeight="SemiBold" Click="OnClose" />
                </Grid>

                <ScrollViewer Grid.Row="1" Margin="20,4,14,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="0,0,4,0">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="输入防抖" Style="{StaticResource RowLabel}" />
                                <Slider x:Name="DebounceSlider" Grid.Column="1" Margin="12,0"
                                        Style="{StaticResource ThinSlider}" Minimum="0" Maximum="300" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock x:Name="DebounceValue" Width="56"
                                               TextAlignment="Right" Style="{StaticResource RowLabel}"
                                               Foreground="{DynamicResource InkSubBrush}" />
                                    <TextBlock Style="{StaticResource InfoDot}"
                                               ToolTip="停下输入多久后才开始搜索结果列表；0 = 每个按键立即搜索。条目多时建议 80–150ms。搜索框与已输入的字符永远即时，不受此值影响。" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="启用" Style="{StaticResource RowLabel}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource InfoDot}"
                                                   ToolTip="开启后可在搜索框用 /s 关键词 检索本地文件与已安装应用（含便签、录音机这类 Windows 程序）；结果只有本地内容，不含快捷项与网页搜索。普通搜索不查本地、不建索引。索引在第一次使用 /s 时后台建立，之后不自动刷新——装了新软件或文件变动后，在 /s 结果里点「重建索引并搜索」即可。默认遍历桌面 / 文档 / 图片 / 下载 / 开始菜单，跳过 node_modules、.git 等目录。" />
                                        <CheckBox x:Name="FileSearchSwitch" Style="{StaticResource Switch}"
                                                  Margin="10,0,0,0" Click="OnFileSearchToggled" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="FileIndexStatus" Style="{StaticResource Hint}" Margin="2,8,0,2" />

                                <StackPanel x:Name="RootRows" Margin="0,4,0,0" />
                                <Button x:Name="AddRootButton" Content="＋ 添加文件夹…" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Left" Padding="0,4" Margin="2,4,0,0" Click="OnAddRoot" />

                                <Grid Margin="2,10,0,0">
                                    <TextBlock Text="索引条目上限" Style="{StaticResource RowLabel}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox x:Name="FileLimitBox" Width="90" TextAlignment="Right" FontSize="12"
                                                 Padding="6,3" VerticalContentAlignment="Center"
                                                 Background="{DynamicResource HoverBrush}"
                                                 Foreground="{DynamicResource InkBrush}"
                                                 BorderBrush="{DynamicResource CardBorderBrush}" />
                                        <TextBlock Text=" 条（0 = 不限制）" Style="{StaticResource Hint}"
                                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                                        <TextBlock Style="{StaticResource InfoDot}"
                                                   ToolTip="所有目录合计的索引条数上限；0 = 不限制。索引只是路径文本（约每条 0.4 KB，十万条约 40 MB）。改动在下次重建索引时生效。" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="搜索引擎" Style="{StaticResource Section}" />
                                    <TextBlock Style="{StaticResource InfoDot}" HorizontalAlignment="Right"
                                               ToolTip="开启后，输入关键词时结果末尾会多出「百度搜索」「谷歌搜索」等条目；回车用系统默认浏览器打开。图标是矢量绘制的品牌色块，任何 DPI 下都清晰。" />
                                </Grid>
                                <StackPanel x:Name="EngineRows" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="24,8,24,16">
                    <Button Content="恢复默认（百度 / 谷歌 / 必应）" Style="{StaticResource LinkButton}"
                            HorizontalAlignment="Left" Padding="0,3" FontSize="11.5" Click="OnResetDefaults" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
