<UserControl x:Class="DesktopJumpList.Views.LauncherPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DesktopJumpList.Models"
             xmlns:controls="clr-namespace:DesktopJumpList.Controls"
             x:Name="RootControl"
             FontFamily="{StaticResource UiFont}"
             Foreground="{DynamicResource InkBrush}"
             Background="Transparent"
             AllowDrop="True"
             DragEnter="Root_DragEnter"
             DragOver="Root_DragOver"
             DragLeave="Root_DragLeave"
             Drop="Root_Drop"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

  <UserControl.Resources>
    <Style x:Key="TypeSegment" TargetType="{x:Type RadioButton}">
      <Setter Property="Height" Value="36" />
      <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RadioButton}">
            <Border x:Name="Root" Background="Transparent" CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentDeepBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ThemeSegment" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource TypeSegment}">
      <Setter Property="Height" Value="34" />
    </Style>

    <Style x:Key="InsightCard" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="StatCard" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="11,10" />
      <Setter Property="Margin" Value="0,0,7,0" />
    </Style>

    <DataTemplate x:Key="ShortcutCardTemplate" DataType="{x:Type models:ShortcutItem}">
      <Grid Margin="5,3">
        <Border x:Name="Card" Height="74" Padding="11,9" MouseRightButtonUp="Card_MouseRightButtonUp"
                AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Target}">
          <Border.Style>
            <Style TargetType="{x:Type Border}">
              <Setter Property="Background" Value="{DynamicResource CardBrush}" />
              <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="CornerRadius" Value="16" />
              <Setter Property="RenderTransform">
                <Setter.Value>
                  <TranslateTransform Y="0" />
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
                  <Setter Property="RenderTransform">
                    <Setter.Value>
                      <TranslateTransform Y="-1" />
                    </Setter.Value>
                  </Setter>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <Border x:Name="IconTile" Width="40" Height="40" CornerRadius="13" Background="{DynamicResource FolderTintBrush}"
                    VerticalAlignment="Center">
              <Grid>
                <Path x:Name="Glyph" Data="{Binding GlyphData}" Width="20" Height="20" Stretch="Uniform"
                      Style="{StaticResource IconStroke}" Stroke="{DynamicResource FolderInkBrush}"
                      Visibility="{Binding Converter={StaticResource NoIconVisibility}}" />
                <Image Source="{Binding Converter={StaticResource IconSource}}" Width="27" Height="27"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
              </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="9,0,4,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           MaxWidth="112" VerticalAlignment="Center" />
                <Path Data="M12 2.6 L14.7 8.4 L21 9.3 L16.5 13.7 L17.6 20 L12 16.9 L6.4 20 L7.5 13.7 L3 9.3 L9.3 8.4 Z"
                      Fill="{DynamicResource AmberBrush}" Width="9" Height="9" Stretch="Uniform" Margin="5,1,0,0"
                      VerticalAlignment="Center" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
              <TextBlock Text="{Binding UsageHint}" FontSize="9.8" Foreground="{DynamicResource InkTertiaryBrush}"
                         TextTrimming="CharacterEllipsis" Margin="0,3,0,0" MaxWidth="112" />
            </StackPanel>

            <Button x:Name="MoreButton" Grid.Column="2" Width="24" Height="24" Style="{StaticResource IconButton}"
                    Opacity="0" Click="ItemMenu_Click" ToolTip="更多操作" VerticalAlignment="Center"
                    AutomationProperties.Name="更多操作">
              <Path Data="M12 5.4 L12 5.6 M12 11.8 L12 12 M12 18.2 L12 18.4" StrokeThickness="2.8"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource InkSecondaryBrush}"
                    Width="18" Height="18" Stretch="Uniform" />
            </Button>
          </Grid>
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ShortcutType.File}">
          <Setter TargetName="IconTile" Property="Background" Value="{DynamicResource FileTintBrush}" />
          <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource FileInkBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ShortcutType.Application}">
          <Setter TargetName="IconTile" Property="Background" Value="{DynamicResource AppTintBrush}" />
          <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource AppInkBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ShortcutType.Url}">
          <Setter TargetName="IconTile" Property="Background" Value="{DynamicResource UrlTintBrush}" />
          <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource UrlInkBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
          <Setter TargetName="MoreButton" Property="Opacity" Value="1" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="MoreButton" Property="Opacity" Value="1" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid x:Name="Root" ClipToBounds="True">
    <Border Background="{DynamicResource PanelGradientBrush}" CornerRadius="26"
            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" />
    <Border Background="{DynamicResource PanelGlowBrush}" CornerRadius="26" IsHitTestVisible="False" />

    <Grid Margin="16,0,16,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="62" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="64" />
      </Grid.RowDefinitions>

      <!-- Brand header -->
      <Grid Grid.Row="0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="34" Height="34" CornerRadius="11" Background="{DynamicResource BrandGradientBrush}">
            <Grid>
              <Path Data="M13.6 2.6 L5.4 13.5 L10.6 13.5 L9.6 21.4 L18.6 10.5 L13.4 10.5 Z" Fill="White"
                    Width="18" Height="18" Stretch="Uniform" />
              <Ellipse Width="3" Height="3" Fill="#B3FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,6,6,0" />
            </Grid>
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="快捷启动" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="JUMP · DESKTOP" FontSize="8.5" Foreground="{DynamicResource InkTertiaryBrush}"
                       Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource IconButton}" Command="{Binding ToggleThemeCommand}" ToolTip="{Binding ThemeToggleHint}"
                  AutomationProperties.Name="切换主题">
            <Grid Width="18" Height="18">
              <Path Data="M12 3.2 L12 5 M12 19 L12 20.8 M3.2 12 L5 12 M19 12 L20.8 12 M5.8 5.8 L7.1 7.1 M16.9 16.9 L18.2 18.2 M18.2 5.8 L16.9 7.1 M7.1 16.9 L5.8 18.2 M12 7.6 A4.4 4.4 0 1 1 12 16.4 A4.4 4.4 0 1 1 12 7.6"
                    Style="{StaticResource IconStroke}" StrokeThickness="1.6"
                    Visibility="{Binding IsDark, Converter={StaticResource BoolToVisibility}}" />
              <Path Data="M20 14.6 A8.6 8.6 0 0 1 9.4 4 A8.6 8.6 0 1 0 20 14.6 Z" Fill="{DynamicResource InkSecondaryBrush}"
                    Width="17" Height="17" Stretch="Uniform"
                    Visibility="{Binding IsDark, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
          </Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding ShowSettingsCommand}" ToolTip="设置" Margin="2,0,0,0"
                  AutomationProperties.Name="设置">
            <Grid Width="18" Height="18">
              <Path Data="M4 6.5 L20 6.5 M4 12 L20 12 M4 17.5 L20 17.5 M8 6.5 L8 6.5 M16 12 L16 12 M10 17.5 L10 17.5"
                    Style="{StaticResource IconStroke}" StrokeThickness="1.7" />
              <Ellipse Width="6" Height="6" Fill="{DynamicResource SurfaceBrush}" Stroke="{DynamicResource InkSecondaryBrush}"
                       StrokeThickness="1.6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,3.5,0,0" />
              <Ellipse Width="6" Height="6" Fill="{DynamicResource SurfaceBrush}" Stroke="{DynamicResource InkSecondaryBrush}"
                       StrokeThickness="1.6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" />
              <Ellipse Width="6" Height="6" Fill="{DynamicResource SurfaceBrush}" Stroke="{DynamicResource InkSecondaryBrush}"
                       StrokeThickness="1.6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7,0,0,3.5" />
            </Grid>
          </Button>
          <Button Style="{StaticResource IconButton}" Click="ClosePanel_Click" ToolTip="收起面板" Margin="2,0,0,0"
                  AutomationProperties.Name="收起面板">
            <Path Data="M7 7 L17 17 M17 7 L7 17" Style="{StaticResource IconStroke}" StrokeThickness="1.7" Width="16" Height="16" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Search -->
      <Border Grid.Row="1" Height="42" CornerRadius="13" Background="{DynamicResource InputBrush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="0,4,0,10">
        <Border.Style>
          <Style TargetType="{x:Type Border}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Background" Value="{DynamicResource InputFocusBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid Margin="12,0,8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Path Data="M10.6 4.2 A6.4 6.4 0 1 1 10.6 17 A6.4 6.4 0 1 1 10.6 4.2 M15.4 15.4 L20 20"
                Style="{StaticResource IconStroke}" StrokeThickness="1.7" Width="17" Height="17"
                HorizontalAlignment="Left" VerticalAlignment="Center" />
          <Grid Grid.Column="1" Margin="1,0,8,0">
            <TextBlock Text="搜索名称、分组或路径…" FontSize="12" Foreground="{DynamicResource InkTertiaryBrush}"
                       VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBox}" AutomationProperties.Name="搜索快捷项"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="SearchBox_PreviewKeyDown" />
          </Grid>
          <Button Grid.Column="2" Width="24" Height="24" Style="{StaticResource IconButton}" Command="{Binding ClearSearchCommand}"
                  ToolTip="清空搜索" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}">
            <Path Data="M6.5 6.5 L17.5 17.5 M17.5 6.5 L6.5 17.5" Style="{StaticResource IconStroke}"
                  StrokeThickness="1.7" Width="14" Height="14" />
          </Button>
          <Border Grid.Column="3" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="6" Padding="6,3" Margin="5,0,1,0"
                  VerticalAlignment="Center" Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Text="Ctrl K" FontSize="9" Foreground="{DynamicResource InkTertiaryBrush}" />
          </Border>
        </Grid>
      </Border>

      <!-- Groups -->
      <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                    Margin="0,0,0,10" PanningMode="HorizontalOnly">
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type models:GroupFilter}">
              <Button Margin="0,0,6,0"
                      Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}">
                <Button.Style>
                  <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ChipButton}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource AccentOnBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsAll}" Value="True">
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding DisplayName}" />
                  <TextBlock Text="{Binding Count}" FontSize="9.5" Margin="5,0,0,0" Opacity="0.62" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Shortcut list -->
      <Grid Grid.Row="3" Visibility="{Binding IsShortcutListVisible, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="26" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="4,0,4,2">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding ListHeader}" Style="{StaticResource SectionTitle}" />
            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="7" Padding="6,1" Margin="7,0,0,0"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding VisibleCount}" FontSize="9.5" Foreground="{DynamicResource InkSecondaryBrush}" />
            </Border>
          </StackPanel>
          <TextBlock Text="拖入文件即可添加" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="9.5"
                     Foreground="{DynamicResource InkTertiaryBrush}" />
        </Grid>

        <ListBox x:Name="ShortcutList" Grid.Row="1" ItemsSource="{Binding ShortcutsView}"
                 ItemTemplate="{StaticResource ShortcutCardTemplate}" ItemContainerStyle="{StaticResource ShortcutListItem}"
                 Style="{StaticResource ShortcutList}" SelectionMode="Single" Margin="-3,0,-3,0"
                 MouseLeftButtonUp="ShortcutList_MouseLeftButtonUp"
                 Visibility="{Binding HasVisibleShortcuts, Converter={StaticResource BoolToVisibility}}" />

        <Grid Grid.Row="1" Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280" Margin="0,-10,0,0">
            <Grid Width="112" Height="92" HorizontalAlignment="Center">
              <Border Width="78" Height="62" CornerRadius="18" Background="{DynamicResource SurfaceAltBrush}"
                      BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1.5" HorizontalAlignment="Left"
                      VerticalAlignment="Top" Margin="6,8,0,0" />
              <Border Width="72" Height="56" CornerRadius="16" Background="{DynamicResource CardBrush}"
                      BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" HorizontalAlignment="Left"
                      VerticalAlignment="Top" Margin="12,14,0,0">
                <Path Data="M3.5 7.5 A2.5 2.5 0 0 1 6 5 L9.4 5 L11.6 7.2 L18 7.2 A2.5 2.5 0 0 1 20.5 9.7 L20.5 17 A2.5 2.5 0 0 1 18 19.5 L6 19.5 A2.5 2.5 0 0 1 3.5 17 Z"
                      Width="27" Height="27" Stretch="Uniform" Style="{StaticResource IconStroke}"
                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
              </Border>
              <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource BrandGradientBrush}"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2">
                <Path Data="M12 6.5 L12 17.5 M6.5 12 L17.5 12" Stroke="White" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform" />
              </Border>
              <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Right"
                       VerticalAlignment="Top" Margin="0,10,4,0" />
            </Grid>
            <TextBlock Text="{Binding EmptyTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="15"
                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
            <TextBlock Text="{Binding EmptySubtitle}" FontSize="11" Foreground="{DynamicResource InkTertiaryBrush}"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0" />
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" HorizontalAlignment="Center"
                    Height="38" Margin="0,18,0,0"
                    Visibility="{Binding ShowEmptyAddButton, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <Path Data="M12 5 L12 19 M5 12 L19 12" Stroke="White" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" />
                <TextBlock Text="添加快捷项" Foreground="White" FontSize="12" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- Insights -->
      <Grid Grid.Row="3" Visibility="{Binding IsInsightsOpen, Converter={StaticResource BoolToVisibility}}">
        <ScrollViewer x:Name="InsightsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="-2,0,-4,0">
          <StackPanel Margin="2,0,6,6">
            <Grid Margin="2,0,2,12">
              <StackPanel>
                <TextBlock Text="使用概览" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding WeekLabel}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
              </StackPanel>
              <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="9,4" HorizontalAlignment="Right"
                      VerticalAlignment="Center">
                <TextBlock Text="最近 7 天" FontSize="9.5" Foreground="{DynamicResource AccentDeepBrush}" FontWeight="SemiBold" />
              </Border>
            </Grid>

            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource StatCard}">
                <StackPanel>
                  <TextBlock Text="{Binding TodayCount}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
                  <TextBlock Text="今天启动" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="0,0,7,0">
                <StackPanel>
                  <TextBlock Text="{Binding WeekCount}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
                  <TextBlock Text="近 7 天" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="0">
                <StackPanel>
                  <TextBlock Text="{Binding TotalOpens}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
                  <TextBlock Text="累计启动" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource InsightCard}">
              <StackPanel>
                <Grid Margin="0,0,0,6">
                  <TextBlock Text="近 7 天启动" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding WeekCount}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentDeepBrush}" />
                    <TextBlock Text=" 次" FontSize="9.5" Foreground="{DynamicResource InkTertiaryBrush}" VerticalAlignment="Bottom" />
                  </StackPanel>
                </Grid>
                <controls:BarChart Height="146" Items="{Binding WeekBars}"
                                   BarBrush="{DynamicResource AccentGradientBrush}"
                                   TrackBrush="{DynamicResource LineBrush}"
                                   TextBrush="{DynamicResource InkBrush}"
                                   MutedTextBrush="{DynamicResource InkTertiaryBrush}" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource InsightCard}">
              <StackPanel>
                <TextBlock Text="类型构成" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid Width="112" Height="112" HorizontalAlignment="Left">
                    <controls:DonutChart Segments="{Binding TypeSegments}" RingThickness="13"
                                         TrackBrush="{DynamicResource LineBrush}" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="{Binding TotalShortcuts}" FontFamily="{StaticResource DisplayFont}" FontSize="21"
                                 FontWeight="SemiBold" HorizontalAlignment="Center" />
                      <TextBlock Text="快捷项" FontSize="9" Foreground="{DynamicResource InkTertiaryBrush}"
                                 HorizontalAlignment="Center" Margin="0,1,0,0" />
                    </StackPanel>
                  </Grid>
                  <ItemsControl Grid.Column="1" ItemsSource="{Binding TypeSegments}" VerticalAlignment="Center" Margin="6,0,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type models:DonutSegment}">
                        <Grid Margin="0,0,0,7">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Ellipse Width="7" Height="7" Fill="{Binding Brush}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="{Binding Value}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PercentText}" FontSize="9.5" Foreground="{DynamicResource InkTertiaryBrush}"
                                       Margin="5,1,0,0" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource InsightCard}" Margin="0">
              <StackPanel>
                <Grid Margin="0,0,0,4">
                  <TextBlock Text="常用排行" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="按累计启动次数" HorizontalAlignment="Right" FontSize="9.5"
                             Foreground="{DynamicResource InkTertiaryBrush}" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding TopShortcuts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:TopShortcut}">
                      <Grid Height="42">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="22" />
                          <ColumnDefinition Width="30" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding RankText}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                   Foreground="{DynamicResource AccentDeepBrush}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}"
                                VerticalAlignment="Center">
                          <Grid>
                            <Path Data="{Binding Item.GlyphData}" Width="15" Height="15" Stretch="Uniform"
                                  Style="{StaticResource IconStroke}" Stroke="{DynamicResource AccentBrush}"
                                  Visibility="{Binding Item, Converter={StaticResource NoIconVisibility}}" />
                            <Image Source="{Binding Item, Converter={StaticResource IconSource}}" Width="18" Height="18"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                          </Grid>
                        </Border>
                        <StackPanel Grid.Column="2" Margin="8,0,10,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Item.Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                          <ProgressBar Style="{StaticResource RatioBar}" Value="{Binding Ratio, Mode=OneWay}" Maximum="100" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding CountText}" FontSize="9.5"
                                   Foreground="{DynamicResource InkTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Footer -->
      <Grid Grid.Row="4" Margin="0,6,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource SubtleButton}" Height="38" Command="{Binding ShowInsightsCommand}" Padding="12,0"
                AutomationProperties.Name="使用概览">
          <StackPanel Orientation="Horizontal">
            <Path Data="M4 19 L4 12 M9.4 19 L9.4 8 M14.8 19 L14.8 14 M20 19 L20 5" Style="{StaticResource IconStroke}"
                  StrokeThickness="1.8" Width="14" Height="14" Margin="0,0,7,0" />
            <TextBlock Text="{Binding OverviewButtonText}" FontSize="11.5" />
          </StackPanel>
        </Button>
        <TextBlock Grid.Column="1" Text="两次点击内抵达" FontSize="9" Foreground="{DynamicResource InkTertiaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Height="40" Command="{Binding AddCommand}" Padding="14,0"
                AutomationProperties.Name="添加快捷项">
          <StackPanel Orientation="Horizontal">
            <Path Data="M12 5 L12 19 M5 12 L19 12" Stroke="White" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" />
            <TextBlock Text="添加快捷项" Foreground="White" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
        </Button>
      </Grid>
    </Grid>

    <!-- Settings overlay -->
    <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Opacity="0" FocusManager.IsFocusScope="True"
          KeyboardNavigation.TabNavigation="Cycle">
      <Border Background="{DynamicResource ScrimBrush}" CornerRadius="26" />
      <Border x:Name="SettingsCard" Margin="14" Background="{DynamicResource OverlayCardBrush}" CornerRadius="22"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="18" RenderTransformOrigin="0.5,0.5"
              VerticalAlignment="Center" MaxHeight="592">
        <Border.Effect>
          <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.24" Color="#FF000000" />
        </Border.Effect>
        <Border.RenderTransform>
          <ScaleTransform x:Name="SettingsScale" ScaleX="0.98" ScaleY="0.98" />
        </Border.RenderTransform>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource IconButton}" Command="{Binding CloseOverlaysCommand}" Width="28" Height="28"
                      ToolTip="返回" Margin="-4,0,6,0">
                <Path Data="M15 6 L9 12 L15 18" Style="{StaticResource IconStroke}" StrokeThickness="1.8" Width="16" Height="16" />
              </Button>
              <TextBlock Text="设置" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Command="{Binding CloseOverlaysCommand}"
                    Width="28" Height="28" ToolTip="关闭">
              <Path Data="M7 7 L17 17 M17 7 L7 17" Style="{StaticResource IconStroke}" StrokeThickness="1.7" Width="15" Height="15" />
            </Button>
          </Grid>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="-2,0,-6,0">
            <StackPanel Margin="2,0,6,0">
              <TextBlock Text="外观" Style="{StaticResource SectionTitle}" Margin="2,0,0,8" />
              <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="12" Padding="4" Margin="0,0,0,16">
                <UniformGrid Columns="3">
                  <RadioButton Style="{StaticResource ThemeSegment}" Content="跟随系统" GroupName="ThemeMode"
                               IsChecked="{Binding ThemeMode, Converter={StaticResource EnumToBool}, ConverterParameter=System, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource ThemeSegment}" Content="浅色" GroupName="ThemeMode"
                               IsChecked="{Binding ThemeMode, Converter={StaticResource EnumToBool}, ConverterParameter=Light, Mode=TwoWay}" />
                  <RadioButton Style="{StaticResource ThemeSegment}" Content="深色" GroupName="ThemeMode"
                               IsChecked="{Binding ThemeMode, Converter={StaticResource EnumToBool}, ConverterParameter=Dark, Mode=TwoWay}" />
                </UniformGrid>
              </Border>

              <TextBlock Text="启动与快捷键" Style="{StaticResource SectionTitle}" Margin="2,0,0,8" />
              <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="12" Padding="13,11" Margin="0,0,0,8">
                <Grid>
                  <StackPanel>
                    <TextBlock Text="开机启动" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="登录 Windows 后自动在桌面边缘待命" FontSize="9.5"
                               Foreground="{DynamicResource InkTertiaryBrush}" Margin="0,3,0,0" />
                  </StackPanel>
                  <CheckBox x:Name="StartupToggle" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartupEnabled}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="12" Padding="13,11" Margin="0,0,0,16">
                <Grid>
                  <StackPanel>
                    <TextBlock Text="全局快捷键" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="在任何应用中呼出或收起面板" FontSize="9.5"
                               Foreground="{DynamicResource InkTertiaryBrush}" Margin="0,3,0,0" />
                    <TextBlock Text="快捷键被其他程序占用，可在下次启动前修改配置" FontSize="9"
                               Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0"
                               Visibility="{Binding HotkeyAvailable, Converter={StaticResource InverseBoolToVisibility}}" />
                  </StackPanel>
                  <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="9,5" HorizontalAlignment="Right"
                          VerticalAlignment="Center" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <TextBlock Text="{Binding HotkeyDisplay}" FontFamily="{StaticResource MonoFont}" FontSize="10" />
                  </Border>
                </Grid>
              </Border>

              <TextBlock Text="数据" Style="{StaticResource SectionTitle}" Margin="2,0,0,8" />
              <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="12" Padding="13,11" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="本地存储" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding DataFolderDisplay}" FontSize="9" Foreground="{DynamicResource InkTertiaryBrush}"
                             TextTrimming="CharacterEllipsis" Margin="0,3,0,8" />
                  <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Height="30" Padding="10,0" Command="{Binding OpenDataFolderCommand}">
                      <TextBlock Text="打开数据文件夹" FontSize="10.5" />
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Height="30" Padding="10,0" Margin="7,0,0,0"
                            Command="{Binding ClearStatsCommand}" Foreground="{DynamicResource DangerBrush}"
                            BorderBrush="{DynamicResource LineStrongBrush}">
                      <TextBlock Text="清空使用统计" FontSize="10.5" Foreground="{DynamicResource DangerBrush}" />
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Grid Margin="2,10,0,2">
                <StackPanel Orientation="Horizontal">
                  <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource BrandGradientBrush}">
                    <Path Data="M13.6 2.6 L5.4 13.5 L10.6 13.5 L9.6 21.4 L18.6 10.5 L13.4 10.5 Z" Fill="White"
                          Width="16" Height="16" Stretch="Uniform" />
                  </Border>
                  <StackPanel Margin="9,0,0,0">
                    <TextBlock Text="Jump" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="{Binding VersionText}" FontSize="9" Foreground="{DynamicResource InkTertiaryBrush}" />
                  </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource GhostButton}" Command="{Binding ExitCommand}" Height="28" Padding="10,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center" BorderBrush="{DynamicResource LineStrongBrush}">
                  <TextBlock Text="退出程序" FontSize="10" Foreground="{DynamicResource DangerBrush}" />
                </Button>
              </Grid>
            </StackPanel>
          </ScrollViewer>

          <Button x:Name="SettingsDoneButton" Grid.Row="2" Style="{StaticResource PrimaryButton}" Content="完成" Height="38"
                  Margin="0,14,0,0" Command="{Binding CloseOverlaysCommand}" AutomationProperties.Name="完成设置" />
        </Grid>
      </Border>
    </Grid>

    <!-- Editor overlay -->
    <Grid x:Name="EditorOverlay" Visibility="Collapsed" Opacity="0" FocusManager.IsFocusScope="True"
          KeyboardNavigation.TabNavigation="Cycle">
      <Border Background="{DynamicResource ScrimBrush}" CornerRadius="26" />
      <Border x:Name="EditorSheet" Margin="12" VerticalAlignment="Bottom" Background="{DynamicResource OverlayCardBrush}"
              CornerRadius="22" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="20,18,20,16">
        <Border.Effect>
          <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.26" Color="#FF000000" />
        </Border.Effect>
        <Border.RenderTransform>
          <TranslateTransform x:Name="EditorTranslate" Y="24" />
        </Border.RenderTransform>
        <StackPanel>
          <Grid Margin="0,0,0,2">
            <StackPanel>
              <TextBlock Text="{Binding Editor.Title}" Style="{StaticResource PageTitle}" />
              <TextBlock Text="名称、目标和分组都可以随时调整。" Style="{StaticResource Caption}" Margin="0,3,0,0" />
            </StackPanel>
            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding Editor.CancelCommand}" Width="28" Height="28" ToolTip="关闭">
              <Path Data="M7 7 L17 17 M17 7 L7 17" Style="{StaticResource IconStroke}" StrokeThickness="1.7" Width="15" Height="15" />
            </Button>
          </Grid>

          <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="11" Padding="3" Margin="0,14,0,14">
            <UniformGrid Columns="4">
              <RadioButton Style="{StaticResource TypeSegment}" Content="文件夹" GroupName="ShortcutType"
                           IsChecked="{Binding Editor.Type, Converter={StaticResource EnumToBool}, ConverterParameter=Folder, Mode=TwoWay}" />
              <RadioButton Style="{StaticResource TypeSegment}" Content="文件" GroupName="ShortcutType"
                           IsChecked="{Binding Editor.Type, Converter={StaticResource EnumToBool}, ConverterParameter=File, Mode=TwoWay}" />
              <RadioButton Style="{StaticResource TypeSegment}" Content="应用" GroupName="ShortcutType"
                           IsChecked="{Binding Editor.Type, Converter={StaticResource EnumToBool}, ConverterParameter=Application, Mode=TwoWay}" />
              <RadioButton Style="{StaticResource TypeSegment}" Content="网页" GroupName="ShortcutType"
                           IsChecked="{Binding Editor.Type, Converter={StaticResource EnumToBool}, ConverterParameter=Url, Mode=TwoWay}" />
            </UniformGrid>
          </Border>

          <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="EditorNameBox" Style="{StaticResource FieldTextBox}" Tag="例如：项目工作区"
                   AutomationProperties.Name="名称"
                   Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Text="{Binding Editor.TargetLabel}" Style="{StaticResource FieldLabel}" Margin="2,12,0,7" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource FieldTextBox}" Tag="{Binding Editor.TargetPlaceholder}"
                     AutomationProperties.Name="目标位置"
                     Text="{Binding Editor.Target, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Width="58" Height="42" Margin="8,0,0,0"
                    Content="浏览" FontSize="11" Click="BrowseButton_Click"
                    Visibility="{Binding Editor.ShowBrowse, Converter={StaticResource BoolToVisibility}}" />
          </Grid>

          <TextBlock Text="分组" Style="{StaticResource FieldLabel}" Margin="2,12,0,7" />
          <TextBox Style="{StaticResource FieldTextBox}" Tag="例如：工作、开发、常用"
                   AutomationProperties.Name="分组"
                   Text="{Binding Editor.Group, UpdateSourceTrigger=PropertyChanged}" />
          <ItemsControl ItemsSource="{Binding Editor.GroupSuggestions}" Margin="0,8,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource ChipButton}" Height="26" Padding="9,0" Margin="0,0,5,0" Content="{Binding}"
                        Background="{DynamicResource SurfaceAltBrush}" Click="GroupSuggestion_Click" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="{Binding Editor.Error}" Foreground="{DynamicResource DangerBrush}" FontSize="10.5" Margin="3,9,0,0"
                     TextWrapping="Wrap" Visibility="{Binding Editor.HasError, Converter={StaticResource BoolToVisibility}}" />

          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource GhostButton}" Content="取消" Height="38" Command="{Binding Editor.CancelCommand}"
                    AutomationProperties.Name="取消编辑" />
            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Height="38" Margin="8,0,0,0" MinWidth="108"
                    Command="{Binding Editor.SaveCommand}" Content="{Binding Editor.ActionLabel}" IsDefault="True"
                    AutomationProperties.Name="保存快捷项" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Drop overlay -->
    <Grid x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False">
      <Border Background="#CC0F1626" CornerRadius="26" />
      <Rectangle Margin="20" RadiusX="22" RadiusY="22" Fill="{DynamicResource AccentSoftBrush}" Stroke="{DynamicResource AccentBrush}"
                 StrokeThickness="2" StrokeDashArray="5 4" Opacity="0.96" />
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="52" Height="52" CornerRadius="16" Background="{DynamicResource BrandGradientBrush}" HorizontalAlignment="Center">
          <Path Data="M12 7 L12 17 M7 12 L17 12" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round"
                StrokeEndLineCap="Round" Width="22" Height="22" Stretch="Uniform" />
        </Border>
        <TextBlock Text="松开以添加" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
        <TextBlock Text="文件、文件夹和应用都可以直接拖进来" FontSize="10.5" Foreground="{DynamicResource InkSecondaryBrush}"
                   HorizontalAlignment="Center" Margin="0,5,0,0" />
      </StackPanel>
    </Grid>

    <!-- Toast -->
    <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="22,0,22,74"
            Background="{DynamicResource ToastBrush}" CornerRadius="12" Padding="12,9" Visibility="Collapsed"
            MaxWidth="380">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.24" Color="#FF000000" />
      </Border.Effect>
      <Border.RenderTransform>
        <TranslateTransform x:Name="ToastTranslate" Y="8" />
      </Border.RenderTransform>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Path Data="M4 10 L8 14 L16 5" Stroke="{DynamicResource ToastInkBrush}" StrokeThickness="1.9"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,1,8,0"
              VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding ToastMessage}" Foreground="{DynamicResource ToastInkBrush}" FontSize="11"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="270" />
        <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="Auto" Height="22" Padding="8,0" Margin="8,0,0,0"
                Command="{Binding UndoCommand}" Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}"
                Background="{DynamicResource ToastActionBrush}">
          <TextBlock Text="撤销" Foreground="{DynamicResource ToastInkBrush}" FontSize="10.5" FontWeight="SemiBold" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
