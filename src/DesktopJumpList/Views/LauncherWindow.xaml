<Window x:Class="DesktopJumpList.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopJumpList.Views"
        xmlns:m="clr-namespace:DesktopJumpList.Models"
        xmlns:inf="clr-namespace:DesktopJumpList.Infrastructure"
        Title="Jump" Width="660" Height="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        Foreground="{DynamicResource InkBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True">

    <Window.Resources>
        <inf:InitialConverter x:Key="Initial" />
        <inf:NameToBrushConverter x:Key="NameBrush" />
        <inf:NullToVisibilityConverter x:Key="NotNullVisible" />
        <inf:NullToVisibilityConverter x:Key="NullVisible" Invert="True" />

        <!-- ===== Shortcut tile ===== -->
        <DataTemplate DataType="{x:Type m:ShortcutItem}">
            <Grid Width="100" Height="96" Background="Transparent"
                  ToolTip="{Binding TooltipText}" ToolTipService.InitialShowDelay="450"
                  ToolTipService.ShowDuration="15000"
                  AutomationProperties.Name="{Binding Name}"
                  AutomationProperties.HelpText="{Binding TooltipText}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="40" Height="40" HorizontalAlignment="Center">
                        <Image Source="{Binding Icon}" Width="40" Height="40" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding Icon, Converter={StaticResource NotNullVisible}}" />
                        <Border CornerRadius="11" Background="{Binding Name, Converter={StaticResource NameBrush}}"
                                Visibility="{Binding Icon, Converter={StaticResource NullVisible}}">
                            <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}" Foreground="White"
                                       FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Name}" Margin="0,8,0,0" Width="88" TextAlignment="Center"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" LineHeight="16"
                               LineStackingStrategy="BlockLineHeight" FontSize="12"
                               Foreground="{DynamicResource InkBrush}" />
                </StackPanel>
                <!-- Pinned marker -->
                <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" Margin="0,10,24,0"
                         HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Pinned}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <!-- Missing-target warning: the target was moved or deleted -->
                <Border Width="14" Height="14" CornerRadius="7" Background="{DynamicResource DangerBrush}"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,12,0,0" IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="!" Foreground="#2A1B00" FontSize="9" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ===== Folder tile (iOS-style grouped shortcuts) ===== -->
        <DataTemplate DataType="{x:Type local:FolderTile}">
            <Grid Width="100" Height="96" Background="Transparent"
                  ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="450"
                  AutomationProperties.Name="{Binding Name}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource HoverBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                        <ItemsControl ItemsSource="{Binding Preview}" Margin="4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="15" Height="15" Margin="1">
                                        <Image Source="{Binding Icon}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding Icon, Converter={StaticResource NotNullVisible}}" />
                                        <Border CornerRadius="3" Background="{Binding Name, Converter={StaticResource NameBrush}}"
                                                Visibility="{Binding Icon, Converter={StaticResource NullVisible}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock Text="{Binding Name}" Margin="0,8,0,0" Width="88" TextAlignment="Center"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" LineHeight="16"
                               LineStackingStrategy="BlockLineHeight" FontSize="12"
                               Foreground="{DynamicResource InkBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ===== Back-to-all tile (inside a folder) ===== -->
        <DataTemplate DataType="{x:Type local:BackTile}">
            <Grid Width="100" Height="96" Background="Transparent" ToolTip="返回全部快捷项"
                  AutomationProperties.Name="返回全部">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="40" Height="40">
                        <Ellipse Fill="{DynamicResource HoverBrush}" />
                        <Path Data="M13,4 L5,12 L13,20" Stroke="{DynamicResource InkSubBrush}" StrokeThickness="1.9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="全部" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource InkSubBrush}" Height="32" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ===== "+" tile ===== -->
        <DataTemplate DataType="{x:Type local:AddTile}">
            <Grid Width="100" Height="96" Background="Transparent" ToolTip="添加文件、文件夹、商店应用或网址"
                  AutomationProperties.Name="添加">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="40" Height="40">
                        <Ellipse Stroke="{DynamicResource InkFaintBrush}" StrokeThickness="1.4" StrokeDashArray="3 2.4" />
                        <Path Data="M0,6 L12,6 M6,0 L6,12" Stroke="{DynamicResource InkSubBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="添加" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource InkSubBrush}" Height="32" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ===== Tile container: one highlight layer that fades, plus press scale ===== -->
        <Style x:Key="TileContainer" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <EventSetter Event="Loaded" Handler="OnTileLoaded" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0">
                            <Border x:Name="Highlight" CornerRadius="14" Margin="3" Opacity="0"
                                    Background="{DynamicResource HoverBrush}" />
                            <Border x:Name="Selection" CornerRadius="14" Margin="3" Opacity="0"
                                    Background="{DynamicResource SelectedBrush}"
                                    BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="1" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Selection" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Selection" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Fixed-size transparent canvas; the stack is vertically centred, so when the panel
         height animates the whole thing stays centred on screen, frame by frame. -->
    <Grid x:Name="Canvas" Margin="36">
        <StackPanel x:Name="Stack" VerticalAlignment="Top" HorizontalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="StackScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="StackShift" Y="0" />
                </TransformGroup>
            </StackPanel.RenderTransform>

            <!-- ===== Pill: search query or a transient message. Invisible when idle. ===== -->
            <Border x:Name="Pill" Height="40" Width="340" Margin="0,0,0,10" CornerRadius="20" Opacity="0"
                    IsHitTestVisible="False"
                    Background="{DynamicResource PillBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                    RenderTransformOrigin="0.5,1">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="PillShift" Y="6" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270"
                                      Color="{DynamicResource ShadowColor}" Opacity="0.16" />
                </Border.Effect>
                <Grid>
                    <Grid x:Name="SearchRow" Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"
                              Stroke="{DynamicResource InkSubBrush}" StrokeThickness="1.6" StrokeEndLineCap="Round"
                              Data="M5.5,0 A5.5,5.5 0 1 1 5.49,0 Z M9.5,9.5 L13,13" />
                        <TextBox x:Name="Query" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 Foreground="{DynamicResource InkBrush}" CaretBrush="{DynamicResource AccentBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"
                                 FontSize="13.5" FocusVisualStyle="{x:Null}"
                                 InputMethod.IsInputMethodEnabled="True" />
                        <TextBlock x:Name="ResultCount" Grid.Column="2" VerticalAlignment="Center" FontSize="11.5"
                                   Foreground="{DynamicResource InkFaintBrush}" />
                    </Grid>
                    <Grid x:Name="MessageRow" Margin="16,0,6,0" Opacity="0" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MessageText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource InkBrush}" />
                        <Button x:Name="MessageAction" Grid.Column="1" Style="{StaticResource LinkButton}"
                                Visibility="Collapsed" FontWeight="SemiBold" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== Panel ===== -->
            <Border x:Name="Panel" Width="530" Height="126" CornerRadius="22"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270"
                                      Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}" />
                </Border.Effect>
                <Grid ClipToBounds="False">
                    <!-- Inner top highlight for a hint of glass -->
                    <Border CornerRadius="21" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelHighlightBrush}"
                            IsHitTestVisible="False" />

                    <ScrollViewer x:Name="Scroller" Margin="14,14,10,14" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False" CanContentScroll="False">
                        <ListBox x:Name="Tiles" Background="Transparent" BorderThickness="0" Padding="0"
                                 Focusable="False" SelectionMode="Single"
                                 Foreground="{DynamicResource InkBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource TileContainer}">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ItemsPresenter />
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" VerticalAlignment="Top" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </ScrollViewer>

                    <!-- Empty library -->
                    <Border x:Name="EmptyState" Margin="16" CornerRadius="16" Visibility="Collapsed"
                            BorderBrush="{DynamicResource DashBrush}" BorderThickness="0" Background="Transparent"
                            Cursor="Hand">
                        <Grid>
                            <Rectangle RadiusX="16" RadiusY="16" Stroke="{DynamicResource DashBrush}"
                                       StrokeThickness="1.4" StrokeDashArray="4 3" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid Width="44" Height="44" HorizontalAlignment="Center">
                                    <Ellipse Fill="{DynamicResource SelectedBrush}" />
                                    <Path Data="M7,0 L7,10 M2.5,6 L7,10.5 L11.5,6 M0,14 L14,14" Stroke="{DynamicResource AccentBrush}"
                                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                           Text="把常用的文件、文件夹、应用拖到这里" />
                                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource InkSubBrush}"
                                           Text="点击这里或拖入文件；也可以按 Ctrl+V 粘贴路径、网址" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- No search results -->
                    <TextBlock x:Name="NoMatch" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource InkSubBrush}" FontSize="13" />

                    <!-- Drag-in overlay -->
                    <Border x:Name="DropOverlay" CornerRadius="21" Opacity="0" IsHitTestVisible="False"
                            Background="{DynamicResource DropBrush}">
                        <Grid Margin="12">
                            <Rectangle RadiusX="14" RadiusY="14" Stroke="{DynamicResource AccentBrush}"
                                       StrokeThickness="1.6" StrokeDashArray="4 3" />
                            <TextBlock Text="松开即可添加" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Rename overlay -->
                    <Border x:Name="RenameOverlay" CornerRadius="21" Opacity="0" Visibility="Collapsed"
                            Background="{DynamicResource DropBrush}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                            <TextBlock Text="重命名" FontSize="12" Foreground="{DynamicResource InkSubBrush}" Margin="2,0,0,8" />
                            <Border CornerRadius="10" Background="{DynamicResource PillBrush}" Padding="12,0" Height="38"
                                    BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="1">
                                <TextBox x:Name="RenameBox" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource InkBrush}" CaretBrush="{DynamicResource AccentBrush}"
                                         FontSize="13.5" FocusVisualStyle="{x:Null}" />
                            </Border>
                            <TextBlock Text="Enter 保存 · Esc 取消" FontSize="11.5" Foreground="{DynamicResource InkFaintBrush}"
                                       Margin="2,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Settings overlay: lives inside the panel, so the app never needs a taskbar window. -->
                    <Border x:Name="SettingsOverlay" CornerRadius="21" Opacity="0" Visibility="Collapsed"
                            Background="{DynamicResource PanelOpaqueBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                        <Grid Margin="24,18,24,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0">
                                <TextBlock Text="设置" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button x:Name="SettingsDone" Content="完成" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Right" FontWeight="SemiBold" Click="OnSettingsDone" />
                            </Grid>

                            <!-- Appearance -->
                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="外观" Style="{StaticResource SettingsLabel}" />
                                <Border Grid.Column="1" HorizontalAlignment="Left" CornerRadius="10" Padding="3"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton x:Name="ThemeSystem" Style="{StaticResource SegmentButton}"
                                                      Content="跟随系统" Click="OnThemeSystem" />
                                        <ToggleButton x:Name="ThemeLight" Style="{StaticResource SegmentButton}"
                                                      Content="浅色" Margin="2,0" Click="OnThemeLight" />
                                        <ToggleButton x:Name="ThemeDark" Style="{StaticResource SegmentButton}"
                                                      Content="深色" Click="OnThemeDark" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Layout -->
                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="布局" Style="{StaticResource SettingsLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="每行" Style="{StaticResource SettingsLabel}" FontSize="11.5" />
                                    <Button x:Name="ColumnsMinus" Style="{StaticResource MiniButton}" Content="−"
                                            Margin="8,0,0,0" Click="OnColumnsMinus" />
                                    <TextBlock x:Name="ColumnsValue" Width="26" TextAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" />
                                    <Button x:Name="ColumnsPlus" Style="{StaticResource MiniButton}" Content="+"
                                            Click="OnColumnsPlus" />
                                    <TextBlock Text="最大行数" Style="{StaticResource SettingsLabel}" FontSize="11.5"
                                               Margin="22,0,0,0" />
                                    <Button x:Name="RowsMinus" Style="{StaticResource MiniButton}" Content="−"
                                            Margin="8,0,0,0" Click="OnRowsMinus" />
                                    <TextBlock x:Name="RowsValue" Width="26" TextAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" />
                                    <Button x:Name="RowsPlus" Style="{StaticResource MiniButton}" Content="+"
                                            Click="OnRowsPlus" />
                                </StackPanel>
                            </Grid>

                            <!-- Auto tuck delay -->
                            <Grid Grid.Row="3" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="自动收起" Style="{StaticResource SettingsLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="PeekMinus" Style="{StaticResource MiniButton}" Content="−"
                                            Click="OnPeekMinus" />
                                    <TextBlock x:Name="PeekValue" Width="56" TextAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" />
                                    <Button x:Name="PeekPlus" Style="{StaticResource MiniButton}" Content="+"
                                            Click="OnPeekPlus" />
                                    <TextBlock Text="后自动缩进屏幕边缘" Style="{StaticResource SettingsLabel}" FontSize="11"
                                               Foreground="{DynamicResource InkFaintBrush}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Hotkey -->
                            <Grid Grid.Row="4" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="快捷键" Style="{StaticResource SettingsLabel}" />
                                <StackPanel Grid.Column="1">
                                    <Border x:Name="HotkeyBox" Width="190" Height="32" HorizontalAlignment="Left"
                                            CornerRadius="8" Background="{DynamicResource SegmentBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            Cursor="Hand" Focusable="True" FocusVisualStyle="{x:Null}"
                                            MouseLeftButtonUp="OnHotkeyBoxClick">
                                        <TextBlock x:Name="HotkeyText" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   FontSize="12.5" Foreground="{DynamicResource InkBrush}" />
                                    </Border>
                                    <TextBlock x:Name="HotkeyHint" Margin="2,6,0,0" FontSize="11"
                                               Foreground="{DynamicResource InkFaintBrush}"
                                               Text="点击后按下新的组合键，Esc 取消" />
                                </StackPanel>
                            </Grid>

                            <!-- Autostart -->
                            <Grid Grid.Row="5" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="开机启动" Style="{StaticResource SettingsLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="AutostartSwitch" Style="{StaticResource Switch}" Click="OnAutostartClick" />
                                    <TextBlock Text="登录 Windows 后在系统托盘启动" Style="{StaticResource SettingsLabel}"
                                               FontSize="11" Foreground="{DynamicResource InkFaintBrush}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="7">
                                <Button x:Name="DataFolderButton" Content="打开数据目录" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Left" Padding="0,3" Click="OnOpenDataFolder" />
                                <TextBlock x:Name="VersionText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource InkFaintBrush}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
