<Window x:Class="DesktopJumpList.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopJumpList.Views"
        xmlns:m="clr-namespace:DesktopJumpList.Models"
        xmlns:inf="clr-namespace:DesktopJumpList.Infrastructure"
        Title="Jump" Width="660" Height="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        Foreground="{DynamicResource InkBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True">

    <Window.Resources>
        <inf:InitialConverter x:Key="Initial" />
        <inf:NameToBrushConverter x:Key="NameBrush" />
        <inf:NullToVisibilityConverter x:Key="NotNullVisible" />
        <inf:NullToVisibilityConverter x:Key="NullVisible" Invert="True" />

        <!-- ===== Tile metrics, written by LauncherWindow.ApplyPanelMetrics ===== -->
        <Style x:Key="TileIconBox" TargetType="Grid">
            <Setter Property="Width" Value="{DynamicResource IconSizeValue}" />
            <Setter Property="Height" Value="{DynamicResource IconSizeValue}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="{DynamicResource LabelMarginValue}" />
            <Setter Property="FontSize" Value="{DynamicResource LabelFontSizeValue}" />
            <Setter Property="LineHeight" Value="{DynamicResource LabelLineHeightValue}" />
            <Setter Property="MaxHeight" Value="{DynamicResource LabelMaxHeightValue}" />
            <Setter Property="Width" Value="88" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>

        <!-- ===== Shortcut tile ===== -->
        <DataTemplate DataType="{x:Type m:ShortcutItem}">
            <Grid Width="{DynamicResource TileWidthValue}" Height="{DynamicResource TileHeightValue}" Background="Transparent"
                  ToolTip="{Binding TooltipText}" ToolTipService.InitialShowDelay="450"
                  ToolTipService.ShowDuration="15000"
                  AutomationProperties.Name="{Binding Name}"
                  AutomationProperties.HelpText="{Binding TooltipText}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Style="{StaticResource TileIconBox}">
                    <Image Source="{Binding Icon}" Width="{DynamicResource IconSizeValue}" Height="{DynamicResource IconSizeValue}"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding Icon, Converter={StaticResource NotNullVisible}}" />
                    <Border CornerRadius="11" Background="{Binding Name, Converter={StaticResource NameBrush}}"
                            Visibility="{Binding Icon, Converter={StaticResource NullVisible}}">
                        <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}" Foreground="White"
                                   FontSize="{DynamicResource LetterFontSizeValue}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- This label has its own grid row, so a two-line name never pushes the icon up. -->
                <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource TileLabel}" />

                <!-- Pinned marker: a pushpin badge, legible on any icon -->
                <Border Width="15" Height="15" CornerRadius="7.5" Margin="0,9,26,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"
                        Background="{DynamicResource PanelOpaqueBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Pinned}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Path Width="9" Height="9" Stretch="Uniform" Fill="{DynamicResource AccentBrush}"
                          Data="M6.2,0.6 L7.4,0.6 L7.6,4.2 L9.4,6 L9.4,7.2 L6.8,7.2 L6.8,11.4 L5.8,11.4 L5.8,7.2 L3.2,7.2 L3.2,6 L5,4.2 Z" />
                </Border>

                <!-- Missing-target warning: the target was moved or deleted -->
                <Border Width="14" Height="14" CornerRadius="7" Background="{DynamicResource DangerBrush}"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,12,0,0" IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="!" Foreground="#2A1B00" FontSize="9" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ===== Folder tile (iOS-style grouped shortcuts) ===== -->
        <DataTemplate DataType="{x:Type local:FolderTile}">
            <Grid Width="{DynamicResource TileWidthValue}" Height="{DynamicResource TileHeightValue}" Background="Transparent"
                  ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="450"
                  AutomationProperties.Name="{Binding Name}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Width="{DynamicResource IconSizeValue}" Height="{DynamicResource IconSizeValue}"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                        CornerRadius="12" Background="{DynamicResource HoverBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                    <Viewbox Margin="4">
                        <ItemsControl ItemsSource="{Binding Preview}" Width="32" Height="32">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="15" Height="15" Margin="1">
                                        <Image Source="{Binding Icon}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding Icon, Converter={StaticResource NotNullVisible}}" />
                                        <Border CornerRadius="3" Background="{Binding Name, Converter={StaticResource NameBrush}}"
                                                Visibility="{Binding Icon, Converter={StaticResource NullVisible}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Viewbox>
                </Border>

                <Border Grid.Row="0" Width="{DynamicResource IconSizeValue}" Height="{DynamicResource IconSizeValue}"
                        Margin="0,8,0,0" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Top"
                        BorderThickness="1.6" IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource TileLabel}" />
            </Grid>
        </DataTemplate>

        <!-- ===== Back-to-all tile (inside a folder) ===== -->
        <DataTemplate DataType="{x:Type local:BackTile}">
            <Grid Width="{DynamicResource TileWidthValue}" Height="{DynamicResource TileHeightValue}" Background="Transparent" ToolTip="返回全部快捷项"
                  AutomationProperties.Name="返回全部">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Style="{StaticResource TileIconBox}">
                    <Ellipse Fill="{DynamicResource HoverBrush}" />
                    <Path Data="M16,4 L8,12 L16,20" Width="16" Height="16" Stretch="Uniform"
                          Stroke="{DynamicResource InkSubBrush}" StrokeThickness="1.9"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <TextBlock Grid.Row="1" Text="全部" Style="{StaticResource TileLabel}"
                           Foreground="{DynamicResource InkSubBrush}" />
            </Grid>
        </DataTemplate>

        <!-- ===== "+" tile ===== -->
        <DataTemplate DataType="{x:Type local:AddTile}">
            <Grid Width="{DynamicResource TileWidthValue}" Height="{DynamicResource TileHeightValue}" Background="Transparent"
                  ToolTip="添加文件、文件夹、商店应用或网址" AutomationProperties.Name="添加">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Style="{StaticResource TileIconBox}">
                    <Ellipse Stroke="{DynamicResource InkFaintBrush}" StrokeThickness="1.4" StrokeDashArray="3 2.4" />
                    <Path Data="M0,6 L12,6 M6,0 L6,12" Stroke="{DynamicResource InkSubBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <TextBlock Grid.Row="1" Text="添加" Style="{StaticResource TileLabel}"
                           Foreground="{DynamicResource InkSubBrush}" />
            </Grid>
        </DataTemplate>

        <!-- ===== "more recently used" tile ===== -->
        <DataTemplate DataType="{x:Type local:MoreRecentTile}">
            <Grid Width="{DynamicResource TileWidthValue}" Height="{DynamicResource TileHeightValue}" Background="Transparent"
                  ToolTip="查看全部最近使用" AutomationProperties.Name="更多最近使用">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Style="{StaticResource TileIconBox}">
                    <Border CornerRadius="11" Background="{DynamicResource HoverBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource InkSubBrush}" />
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource InkSubBrush}" Margin="3,0,0,0" />
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource InkSubBrush}" Margin="3,0,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="1" Text="更多" Style="{StaticResource TileLabel}"
                           Foreground="{DynamicResource InkSubBrush}" />
            </Grid>
        </DataTemplate>

        <!-- ===== Web search row (advanced settings → 搜索引擎) ===== -->
        <DataTemplate DataType="{x:Type m:SearchResultTile}">
            <Grid Width="{DynamicResource TileWidthValue}" Height="{DynamicResource TileHeightValue}"
                  Background="Transparent" ToolTip="{Binding Title}" ToolTipService.InitialShowDelay="450"
                  AutomationProperties.Name="{Binding Title}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Style="{StaticResource TileIconBox}">
                    <Border Width="{DynamicResource IconSizeValue}" Height="{DynamicResource IconSizeValue}"
                            CornerRadius="12" Background="{Binding Engine.BrandBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Engine.Monogram}" Foreground="White" FontWeight="SemiBold"
                                   FontSize="{DynamicResource LetterFontSizeValue}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource TileLabel}" />
            </Grid>
        </DataTemplate>

        <!-- ===== One-line result row (search results and the "/" palette) ===== -->
        <DataTemplate DataType="{x:Type m:ResultRow}">
            <Grid Height="{DynamicResource RowHeightValue}" Background="Transparent"
                  ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="400"
                  AutomationProperties.Name="{Binding Title}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 12 px from the panel edge, 24 px icon, 12 px gap before the text. -->
                <Grid Width="24" Height="24" Margin="12,0,0,0" VerticalAlignment="Center"
                      HorizontalAlignment="Left">
                    <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding Icon, Converter={StaticResource NotNullVisible}}" />
                    <Border CornerRadius="7" Background="{Binding Accent}"
                            Visibility="{Binding Accent, Converter={StaticResource NotNullVisible}}">
                        <TextBlock Text="{Binding Glyph}" Foreground="White" FontSize="11.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource InkBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Margin="0,1,0,0"
                               Foreground="{DynamicResource InkFaintBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ===== "/" palette row: glyph + name, with the usage as a second line ===== -->
        <DataTemplate DataType="{x:Type m:SlashRow}">
            <Grid Width="{DynamicResource TileWidthValue}" Height="{DynamicResource TileHeightValue}"
                  Background="Transparent" ToolTip="{Binding Subtitle}" ToolTipService.InitialShowDelay="350"
                  AutomationProperties.Name="{Binding Title}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Style="{StaticResource TileIconBox}">
                    <Border Width="{DynamicResource IconSizeValue}" Height="{DynamicResource IconSizeValue}"
                            CornerRadius="12" Background="{Binding Accent}"
                            HorizontalAlignment="Center" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Glyph}" Foreground="White" FontWeight="SemiBold"
                                   FontSize="{DynamicResource LetterFontSizeValue}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <StackPanel Grid.Row="1" Margin="{DynamicResource LabelMarginValue}" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource LabelFontSizeValue}"
                               Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="{DynamicResource TileWidthValue}" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="9.5" Margin="0,1,0,0"
                               Foreground="{DynamicResource InkFaintBrush}" HorizontalAlignment="Center"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="{DynamicResource TileWidthValue}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ===== Drop placeholder: the gap that opens where the tile will land ===== -->
        <DataTemplate DataType="{x:Type local:InsertMarker}">
            <Grid Width="{DynamicResource TileWidthValue}" Height="{DynamicResource TileHeightValue}"
                  IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Width="{DynamicResource IconSizeValue}" Height="{DynamicResource IconSizeValue}"
                        Margin="0,8,0,0" CornerRadius="12"
                        Background="{DynamicResource SelectedBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.4" />
                <Rectangle Grid.Row="1" Height="{DynamicResource LabelLineHeightValue}" Margin="10,10,10,0"
                           VerticalAlignment="Top" RadiusX="4" RadiusY="4"
                           Fill="{DynamicResource HoverBrush}" />
            </Grid>
        </DataTemplate>

        <!-- ===== Tile container: one highlight layer that fades, plus press scale ===== -->
        <Style x:Key="TileContainer" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <!-- The gap between tiles lives on the cell, so the panel width/height is
                 columns*(tile+gap)-gap and the grid can never overlap. -->
            <Setter Property="Margin" Value="{DynamicResource TileMarginValue}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0">
                            <Border x:Name="Highlight" CornerRadius="14" Margin="3" Opacity="0"
                                    Background="{DynamicResource HoverBrush}" />
                            <Border x:Name="Selection" CornerRadius="14" Margin="3" Opacity="0"
                                    Background="{DynamicResource SelectedBrush}"
                                    BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="1" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Selection" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Selection" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorDot" TargetType="RadioButton">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="26" Height="26">
                            <Ellipse Width="20" Height="20" Fill="{TemplateBinding Background}"
                                     Stroke="#2A000000" StrokeThickness="1" />
                            <Ellipse x:Name="Ring" Width="26" Height="26"
                                     Stroke="{DynamicResource InkBrush}" StrokeThickness="1.6" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="SettingsSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkSubBrush}" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>
        <Style x:Key="SettingsRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,7,0,0" />
        </Style>
        <Style x:Key="SettingsSlider" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource PanelOpaqueBrush}"
                                                         Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource ToggleTrackBrush}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>        <!-- One-line result rows: same hover/selection visuals as a tile, no grid gap. -->
        <Style x:Key="RowContainer" TargetType="ListBoxItem" BasedOn="{StaticResource TileContainer}">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </Window.Resources>

    <!-- Fixed-size transparent canvas; the stack is top-anchored so the search pill and panel
         top stay put while the result count (and panel height) changes. -->
    <Grid x:Name="Canvas" Margin="36">
        <StackPanel x:Name="Stack" VerticalAlignment="Top" HorizontalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="StackScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="StackShift" Y="0" />
                </TransformGroup>
            </StackPanel.RenderTransform>

            <!-- ===== Pill: search query or a transient message. Invisible when idle. ===== -->
            <Border x:Name="Pill" Height="40" Width="340" Margin="0,0,0,10" CornerRadius="20" Opacity="0"
                    IsHitTestVisible="False"
                    Background="{DynamicResource PillBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                    RenderTransformOrigin="0.5,1">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="PillShift" Y="6" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270"
                                      Color="{DynamicResource ShadowColor}" Opacity="0.16" />
                </Border.Effect>
                <Grid>
                    <Grid x:Name="SearchRow" Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"
                              Stroke="{DynamicResource InkSubBrush}" StrokeThickness="1.6" StrokeEndLineCap="Round"
                              Data="M5.5,0 A5.5,5.5 0 1 1 5.49,0 Z M9.5,9.5 L13,13" />
                        <TextBox x:Name="Query" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 Foreground="{DynamicResource InkBrush}" CaretBrush="{DynamicResource AccentBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"
                                 FontSize="13.5" FocusVisualStyle="{x:Null}"
                                 InputMethod.IsInputMethodEnabled="True" />
                        <TextBlock x:Name="ResultCount" Grid.Column="2" VerticalAlignment="Center" FontSize="11.5"
                                   Foreground="{DynamicResource InkFaintBrush}" />
                    </Grid>
                    <Grid x:Name="MessageRow" Margin="16,0,6,0" Opacity="0" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MessageText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource InkBrush}" />
                        <Button x:Name="MessageAction" Grid.Column="1" Style="{StaticResource LinkButton}"
                                Visibility="Collapsed" FontWeight="SemiBold" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== Panel ===== -->
            <Border x:Name="Panel" Width="530" Height="126" CornerRadius="22"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270"
                                      Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}" />
                </Border.Effect>
                <Grid ClipToBounds="False">
                    <!-- Inner top highlight for a hint of glass -->
                    <Border CornerRadius="21" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelHighlightBrush}"
                            IsHitTestVisible="False" />

                    <!-- Layout-editing state: a clear accent ring around the panel. -->
                    <Border x:Name="EditGlow" CornerRadius="21" BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="2" Opacity="0" IsHitTestVisible="False" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- One-row recently used header, above the divider. -->
                        <StackPanel x:Name="RecentSection" Grid.Row="0" Visibility="Collapsed">
                            <ListBox x:Name="RecentTiles" Margin="14,14,10,0" Height="{DynamicResource RecentRowHeightValue}"
                                     Background="Transparent" BorderThickness="0" Padding="0" Focusable="False"
                                     SelectionMode="Single" Foreground="{DynamicResource InkBrush}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource TileContainer}">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <ItemsPresenter />
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="5" VerticalAlignment="Top" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                            <Border Height="1" Margin="14,6,10,8" Background="{DynamicResource PanelBorderBrush}" />
                        </StackPanel>

                        <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="14,14,10,14" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Focusable="False" CanContentScroll="False">
                            <ListBox x:Name="Tiles" Background="Transparent" BorderThickness="0" Padding="0"
                                     Focusable="False" SelectionMode="Single"
                                     Foreground="{DynamicResource InkBrush}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource TileContainer}">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <ItemsPresenter />
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="5" VerticalAlignment="Top" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </ScrollViewer>
                    </Grid>

                    <!-- Empty library -->
                    <Border x:Name="EmptyState" Margin="16" CornerRadius="16" Visibility="Collapsed"
                            BorderBrush="{DynamicResource DashBrush}" BorderThickness="0" Background="Transparent"
                            Cursor="Hand">
                        <Grid>
                            <Rectangle RadiusX="16" RadiusY="16" Stroke="{DynamicResource DashBrush}"
                                       StrokeThickness="1.4" StrokeDashArray="4 3" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid Width="44" Height="44" HorizontalAlignment="Center">
                                    <Ellipse Fill="{DynamicResource SelectedBrush}" />
                                    <Path Data="M7,0 L7,10 M2.5,6 L7,10.5 L11.5,6 M0,14 L14,14" Stroke="{DynamicResource AccentBrush}"
                                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                           Text="把常用的文件、文件夹、应用拖到这里" />
                                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource InkSubBrush}"
                                           Text="点击这里或拖入文件；也可以按 Ctrl+V 粘贴路径、网址" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- No search results -->
                    <TextBlock x:Name="NoMatch" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource InkSubBrush}" FontSize="13" />

                    <!-- Drag-in overlay -->
                    <Border x:Name="DropOverlay" CornerRadius="21" Opacity="0" IsHitTestVisible="False"
                            Background="{DynamicResource DropBrush}">
                        <Grid Margin="12">
                            <Rectangle RadiusX="14" RadiusY="14" Stroke="{DynamicResource AccentBrush}"
                                       StrokeThickness="1.6" StrokeDashArray="4 3" />
                            <TextBlock Text="松开即可添加" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Rename overlay -->
                    <Border x:Name="RenameOverlay" CornerRadius="21" Opacity="0" Visibility="Collapsed"
                            Background="{DynamicResource DropBrush}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                            <TextBlock Text="重命名" FontSize="12" Foreground="{DynamicResource InkSubBrush}" Margin="2,0,0,8" />
                            <Border CornerRadius="10" Background="{DynamicResource PillBrush}" Padding="12,0" Height="38"
                                    BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="1">
                                <TextBox x:Name="RenameBox" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource InkBrush}" CaretBrush="{DynamicResource AccentBrush}"
                                         FontSize="13.5" FocusVisualStyle="{x:Null}" />
                            </Border>
                            <TextBlock Text="Enter 保存 · Esc 取消" FontSize="11.5" Foreground="{DynamicResource InkFaintBrush}"
                                       Margin="2,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Settings overlay: lives inside the panel, so the app never needs a taskbar window. -->
                                        <Border x:Name="SettingsOverlay" CornerRadius="21" Opacity="0" Visibility="Collapsed"
                            Background="{DynamicResource PanelOpaqueBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="24,18,24,8">
                                <TextBlock Text="设置" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button x:Name="SettingsDone" Content="完成" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Right" FontWeight="SemiBold" Click="OnSettingsDone" />
                            </Grid>

                            <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" Margin="20,0,14,14"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <StackPanel Margin="0,0,4,0">

                                    <!-- 外观 -->
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Text="外观" Style="{StaticResource SettingsSection}" />
                                            <Grid Style="{StaticResource SettingsRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="84" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="主题" Style="{StaticResource SettingsLabel}" />
                                                <Border Grid.Column="1" HorizontalAlignment="Left" CornerRadius="10" Padding="3"
                                                        Background="{DynamicResource CardBrush}"
                                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ToggleButton x:Name="ThemeSystem" Style="{StaticResource SegmentButton}"
                                                                      Content="跟随系统" Click="OnThemeSystem" />
                                                        <ToggleButton x:Name="ThemeLight" Style="{StaticResource SegmentButton}"
                                                                      Content="浅色" Margin="2,0" Click="OnThemeLight" />
                                                        <ToggleButton x:Name="ThemeDark" Style="{StaticResource SegmentButton}"
                                                                      Content="深色" Click="OnThemeDark" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <Grid Style="{StaticResource SettingsRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="84" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="面板透明度" Style="{StaticResource SettingsLabel}" />
                                                <Grid Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="48" />
                                                    </Grid.ColumnDefinitions>
                                                    <Slider x:Name="OpacitySlider" Style="{StaticResource SettingsSlider}"
                                                            Minimum="50" Maximum="100" Value="85"
                                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                                            ValueChanged="OnOpacityChanged" />
                                                    <TextBlock x:Name="OpacityValue" Grid.Column="1" Text="85%"
                                                               TextAlignment="Right" FontSize="12"
                                                               Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 布局与面板 -->
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Text="布局与面板" Style="{StaticResource SettingsSection}" />
                                            <Grid Style="{StaticResource SettingsRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="每行" Style="{StaticResource SettingsLabel}" FontSize="11.5" />
                                                    <Button x:Name="ColumnsMinus" Style="{StaticResource MiniButton}" Content="−"
                                                            Margin="8,0,0,0" Click="OnColumnsMinus" />
                                                    <TextBlock x:Name="ColumnsValue" Width="26" TextAlignment="Center" FontSize="12"
                                                               Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" />
                                                    <Button x:Name="ColumnsPlus" Style="{StaticResource MiniButton}" Content="+"
                                                            Click="OnColumnsPlus" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="最大行数" Style="{StaticResource SettingsLabel}" FontSize="11.5" />
                                                    <Button x:Name="RowsMinus" Style="{StaticResource MiniButton}" Content="−"
                                                            Margin="8,0,0,0" Click="OnRowsMinus" />
                                                    <TextBlock x:Name="RowsValue" Width="26" TextAlignment="Center" FontSize="12"
                                                               Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" />
                                                    <Button x:Name="RowsPlus" Style="{StaticResource MiniButton}" Content="+"
                                                            Click="OnRowsPlus" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Style="{StaticResource SettingsRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="图标" Style="{StaticResource SettingsLabel}" FontSize="11.5" />
                                                    <Button x:Name="IconMinus" Style="{StaticResource MiniButton}" Content="−"
                                                            Margin="6,0,0,0" Click="OnIconMinus" />
                                                    <TextBlock x:Name="IconValue" Width="24" TextAlignment="Center" FontSize="12"
                                                               Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" />
                                                    <Button x:Name="IconPlus" Style="{StaticResource MiniButton}" Content="+"
                                                            Click="OnIconPlus" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="文字" Style="{StaticResource SettingsLabel}" FontSize="11.5" />
                                                    <Button x:Name="FontMinus" Style="{StaticResource MiniButton}" Content="−"
                                                            Margin="6,0,0,0" Click="OnFontMinus" />
                                                    <TextBlock x:Name="FontValue" Width="24" TextAlignment="Center" FontSize="12"
                                                               Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" />
                                                    <Button x:Name="FontPlus" Style="{StaticResource MiniButton}" Content="+"
                                                            Click="OnFontPlus" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="间距" Style="{StaticResource SettingsLabel}" FontSize="11.5" />
                                                    <Button x:Name="GapMinus" Style="{StaticResource MiniButton}" Content="−"
                                                            Margin="6,0,0,0" Click="OnGapMinus" />
                                                    <TextBlock x:Name="GapValue" Width="24" TextAlignment="Center" FontSize="12"
                                                               Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" />
                                                    <Button x:Name="GapPlus" Style="{StaticResource MiniButton}" Content="+"
                                                            Click="OnGapPlus" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Style="{StaticResource SettingsRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="84" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="最近使用" Style="{StaticResource SettingsLabel}" FontSize="11.5" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="RecentMinus" Style="{StaticResource MiniButton}" Content="−"
                                                            Click="OnRecentMinus" />
                                                    <TextBlock x:Name="RecentValue" Width="26" TextAlignment="Center" FontSize="12"
                                                               Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" />
                                                    <Button x:Name="RecentPlus" Style="{StaticResource MiniButton}" Content="+"
                                                            Click="OnRecentPlus" />
                                                    <TextBlock Text="条 · 顶部一行，超出显示「更多」" FontSize="11"
                                                               Foreground="{DynamicResource InkFaintBrush}" Margin="10,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 悬浮球 -->
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Text="悬浮球" Style="{StaticResource SettingsSection}" />
                                            <Grid Style="{StaticResource SettingsRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="84" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="显示" Style="{StaticResource SettingsLabel}" FontSize="11.5" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox x:Name="DockVisibleSwitch" Style="{StaticResource Switch}"
                                                              Click="OnDockVisibleClick" />
                                                    <TextBlock Text="悬浮球" Style="{StaticResource SettingsLabel}" FontSize="11.5"
                                                               Margin="8,0,0,0" />
                                                    <TextBlock Text="自动收起" Style="{StaticResource SettingsLabel}" FontSize="11.5"
                                                               Margin="20,0,0,0" />
                                                    <Button x:Name="PeekMinus" Style="{StaticResource MiniButton}" Content="−"
                                                            Margin="6,0,0,0" Click="OnPeekMinus" />
                                                    <TextBlock x:Name="PeekValue" Width="56" TextAlignment="Center" FontSize="12"
                                                               Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" />
                                                    <Button x:Name="PeekPlus" Style="{StaticResource MiniButton}" Content="+"
                                                            Click="OnPeekPlus" />
                                                    <TextBlock Text="后缩成贴边细条" FontSize="10.5"
                                                               Foreground="{DynamicResource InkFaintBrush}" Margin="6,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Style="{StaticResource SettingsRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="84" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="大小" Style="{StaticResource SettingsLabel}" FontSize="11.5" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="DockSizeMinus" Style="{StaticResource MiniButton}" Content="−"
                                                            Click="OnDockSizeMinus" />
                                                    <TextBlock x:Name="DockSizeValue" Width="52" TextAlignment="Center" FontSize="12"
                                                               Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" />
                                                    <Button x:Name="DockSizePlus" Style="{StaticResource MiniButton}" Content="+"
                                                            Click="OnDockSizePlus" />
                                                    <TextBlock Text="吸附距离" Style="{StaticResource SettingsLabel}" FontSize="11.5"
                                                               Margin="20,0,0,0" />
                                                    <Button x:Name="SnapMinus" Style="{StaticResource MiniButton}" Content="−"
                                                            Margin="6,0,0,0" Click="OnSnapMinus" />
                                                    <TextBlock x:Name="SnapValue" Width="44" TextAlignment="Center" FontSize="12"
                                                               Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" />
                                                    <Button x:Name="SnapPlus" Style="{StaticResource MiniButton}" Content="+"
                                                            Click="OnSnapPlus" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Style="{StaticResource SettingsRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="84" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="圆点颜色" Style="{StaticResource SettingsLabel}" FontSize="11.5" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <RadioButton x:Name="ColorWhite" Style="{StaticResource ColorDot}" Background="#FFFFFF"
                                                                 Tag="#FFFFFF" GroupName="DockColor" Checked="OnDockColorChecked" />
                                                    <RadioButton x:Name="ColorGraphite" Style="{StaticResource ColorDot}" Background="#2B2F36"
                                                                 Tag="#2B2F36" GroupName="DockColor" Checked="OnDockColorChecked" />
                                                    <RadioButton x:Name="ColorGray" Style="{StaticResource ColorDot}" Background="#D1D5DB"
                                                                 Tag="#D1D5DB" GroupName="DockColor" Checked="OnDockColorChecked" />
                                                    <RadioButton x:Name="ColorBlue" Style="{StaticResource ColorDot}" Background="#3B82F6"
                                                                 Tag="#3B82F6" GroupName="DockColor" Checked="OnDockColorChecked" />
                                                    <RadioButton x:Name="ColorGreen" Style="{StaticResource ColorDot}" Background="#22C55E"
                                                                 Tag="#22C55E" GroupName="DockColor" Checked="OnDockColorChecked" />
                                                    <RadioButton x:Name="ColorOrange" Style="{StaticResource ColorDot}" Background="#F59E0B"
                                                                 Tag="#F59E0B" GroupName="DockColor" Checked="OnDockColorChecked" />
                                                    <RadioButton x:Name="ColorRose" Style="{StaticResource ColorDot}" Background="#F43F5E"
                                                                 Tag="#F43F5E" GroupName="DockColor" Checked="OnDockColorChecked" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 快捷键与启动 -->
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Text="快捷键与启动" Style="{StaticResource SettingsSection}" />
                                            <Grid Style="{StaticResource SettingsRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="84" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="全局快捷键" Style="{StaticResource SettingsLabel}" FontSize="11.5" />
                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox x:Name="HotkeySwitch" Style="{StaticResource Switch}"
                                                                  Click="OnHotkeyEnabledClick" />
                                                        <TextBlock Text="启用" Style="{StaticResource SettingsLabel}" FontSize="11.5"
                                                                   Margin="8,0,0,0" />
                                                        <Border x:Name="HotkeyBox" Width="170" Height="32" Margin="12,0,0,0"
                                                                CornerRadius="8" Background="{DynamicResource SegmentBrush}"
                                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                                Cursor="Hand" Focusable="True" FocusVisualStyle="{x:Null}"
                                                                MouseLeftButtonUp="OnHotkeyBoxClick">
                                                            <TextBlock x:Name="HotkeyText" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                       FontSize="12.5" Foreground="{DynamicResource InkBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock x:Name="HotkeyHint" Margin="2,6,0,0" FontSize="11"
                                                               Foreground="{DynamicResource InkFaintBrush}"
                                                               Text="默认关闭；打开开关后生效，点击这里可先改组合键" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Style="{StaticResource SettingsRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="84" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="开机启动" Style="{StaticResource SettingsLabel}" FontSize="11.5" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox x:Name="AutostartSwitch" Style="{StaticResource Switch}" Click="OnAutostartClick" />
                                                    <TextBlock Text="登录 Windows 后在系统托盘启动" Style="{StaticResource SettingsLabel}"
                                                               FontSize="11" Foreground="{DynamicResource InkFaintBrush}" Margin="10,0,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="4,2,4,0">
                                        <Button x:Name="DataFolderButton" Content="打开数据目录" Style="{StaticResource LinkButton}"
                                                HorizontalAlignment="Left" Padding="0,3" Click="OnOpenDataFolder" />
                                        <TextBlock x:Name="VersionText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontSize="11" Foreground="{DynamicResource InkFaintBrush}" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== Edit-mode status strip: below the panel so it never covers a tile ===== -->
            <Border x:Name="EditHintBar" Margin="0,10,0,0" CornerRadius="13" Padding="14,7"
                    HorizontalAlignment="Center" Visibility="Collapsed" Opacity="0"
                    Background="{DynamicResource PillBrush}"
                    BorderBrush="{DynamicResource SelectedBorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                             Fill="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="EditHintText" Margin="8,0,0,0" FontSize="11.5"
                               Foreground="{DynamicResource InkBrush}"
                               Text="拖动调整顺序 · 拖到图标上合并成分组 · 拖到边缘自动滚动 · Esc 完成" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
