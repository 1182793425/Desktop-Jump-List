<Window x:Class="DesktopJumpList.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jump" Width="80" Height="80"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid x:Name="Root" ClipToBounds="True">

        <!-- While tucked, the ball is fully off-screen; only the slim edge handle shows.
             This translucent strip keeps a comfortable hover target around it. -->
        <Border x:Name="HitStrip" Width="18" Height="64" Background="#01FFFFFF"
                HorizontalAlignment="Right" VerticalAlignment="Center" />

        <!-- Edge handle shown in the tucked state: a small brand-coloured tab. -->
        <Border x:Name="Handle" Width="6" Height="36" CornerRadius="3" Opacity="0"
                HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#3D6BFF" Offset="0" />
                    <GradientStop Color="#7C3AED" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#2A2F8A" Opacity="0.55" />
            </Border.Effect>
        </Border>

        <!-- The ball: a squircle app tile using the same mark as the app icon. -->
        <Grid x:Name="Ball" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5" Cursor="Hand"
              AutomationProperties.Name="Jump"
              AutomationProperties.HelpText="单击打开面板，右键更多选项">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BallScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="BallShift" X="0" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Grid.ToolTip>
                <StackPanel>
                    <TextBlock Text="Jump" FontWeight="SemiBold" />
                    <TextBlock Text="单击打开面板 · 右键更多选项" Foreground="{DynamicResource InkSubBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid.ToolTip>

            <Border CornerRadius="14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                        <GradientStop Color="#3D6BFF" Offset="0" />
                        <GradientStop Color="#5C5AF8" Offset="0.5" />
                        <GradientStop Color="#7C3AED" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect x:Name="BallShadow" BlurRadius="14" ShadowDepth="3" Direction="270"
                                      Color="#2A2F8A" Opacity="0.42" />
                </Border.Effect>
            </Border>

            <!-- Top light so the tile reads as a physical object, not a flat disc. -->
            <Border CornerRadius="13" Margin="1" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.2,0" EndPoint="0.5,1">
                        <GradientStop Color="#42FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="0.65" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border CornerRadius="14" BorderBrush="#2BFFFFFF" BorderThickness="1" IsHitTestVisible="False" />

            <!-- The mark: 2x2 tiles, the top-right one lifted out of the grid. -->
            <Grid Width="24" Height="24" IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Margin="1" CornerRadius="3" Background="#E6FFFFFF" />
                <Border Grid.Row="1" Grid.Column="0" Margin="1" CornerRadius="3" Background="#E6FFFFFF" />
                <Border Grid.Row="1" Grid.Column="1" Margin="1" CornerRadius="3" Background="#E6FFFFFF" />
                <Border Grid.Row="0" Grid.Column="1" Margin="1" CornerRadius="3" Background="#FFFFFF">
                    <Border.RenderTransform>
                        <TranslateTransform X="1.6" Y="-1.6" />
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
