<Window x:Class="DesktopJumpList.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jump" Width="72" Height="72"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid x:Name="Root" ClipToBounds="True">

        <!-- When tucked, only a sliver of the ball is on screen. This near-invisible strip
             (alpha 1/255 is still hit-testable in a layered window) widens the hover target. -->
        <Border x:Name="HitStrip" Width="14" Height="52" Background="#01FFFFFF"
                HorizontalAlignment="Right" VerticalAlignment="Center" />

        <Grid x:Name="Ball" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5" Cursor="Hand">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BallScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="BallShift" X="0" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Ellipse>
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0.15,0" EndPoint="0.85,1">
                        <GradientStop Color="#4F80FF" Offset="0" />
                        <GradientStop Color="#6A63FF" Offset="0.55" />
                        <GradientStop Color="#8A5CFF" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <DropShadowEffect x:Name="BallShadow" BlurRadius="14" ShadowDepth="3" Direction="270"
                                      Color="#3A3FD0" Opacity="0.38" />
                </Ellipse.Effect>
            </Ellipse>

            <!-- Glass highlight -->
            <Ellipse Margin="3,2,3,14" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#55FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Stroke="#33FFFFFF" StrokeThickness="1" IsHitTestVisible="False" />

            <!-- Glyph: a paper plane = "jump / quick arrival" -->
            <Path IsHitTestVisible="False" Data="M2,21 L23,12 L2,3 L2,10 L17,12 L2,14 Z"
                  Fill="White" Width="19" Height="19" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <TranslateTransform X="-0.5" Y="-1" />
                </Path.RenderTransform>
            </Path>
        </Grid>
    </Grid>
</Window>
