<Window x:Class="DesktopJumpList.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jump" Width="80" Height="80"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid x:Name="Root" ClipToBounds="True">

        <!-- Translucent hit target so a tucked bar is still easy to reach. -->
        <Border x:Name="HitStrip" Width="18" Height="64" Background="#01FFFFFF"
                HorizontalAlignment="Right" VerticalAlignment="Center" />

        <!-- The circle. When tucked it morphs into a slim capsule and slides until it is
             flush with the screen edge, so a bar stays visible instead of a cut circle. -->
        <Grid x:Name="Ball" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5" Cursor="Hand"
              AutomationProperties.Name="Jump"
              AutomationProperties.HelpText="单击打开面板，右键更多选项">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BallScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="BallShift" X="0" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Grid.ToolTip>
                <StackPanel>
                    <TextBlock Text="Jump" FontWeight="SemiBold" />
                    <TextBlock Text="单击打开面板 · 右键更多选项" Foreground="{DynamicResource InkSubBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid.ToolTip>

            <!-- A single rounded-rectangle geometry. Animating its rect and corner radius morphs
                 the circle into a capsule bar instead of cross-fading two separate shapes. -->
            <Path x:Name="BallShape" Width="48" Height="48" Stretch="None"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  Fill="White" Stroke="#24000000" StrokeThickness="1">
                <Path.Effect>
                    <DropShadowEffect x:Name="BallShadow" BlurRadius="14" ShadowDepth="3" Direction="270"
                                      Color="#000000" Opacity="0.30" />
                </Path.Effect>
            </Path>
        </Grid>
    </Grid>
</Window>
