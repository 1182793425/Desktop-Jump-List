<UserControl x:Class="DesktopJumpList.Views.AdvancedSettingsPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        Foreground="{DynamicResource InkBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkSubBrush}" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ThinSlider" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource PanelOpaqueBrush}"
                                                         Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Small ⓘ next to a row: the explanation lives in its ToolTip. -->
        <Style x:Key="InfoDot" TargetType="TextBlock">
            <Setter Property="Text" Value="ⓘ" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        </Style>
        <!-- Dark rounded tooltips matching the panel instead of the yellow system ones. -->
        <Style TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource PanelOpaqueBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="12,9" MaxWidth="380">
                            <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel x:Name="ModuleRoot">
        <StackPanel x:Name="ModuleStack">
                        <Border x:Name="DebounceCard" Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="输入防抖" Style="{StaticResource RowLabel}" />
                                <Slider x:Name="DebounceSlider" Grid.Column="1" Margin="12,0"
                                        Style="{StaticResource ThinSlider}" Minimum="0" Maximum="300" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock x:Name="DebounceValue" Width="56"
                                               TextAlignment="Right" Style="{StaticResource RowLabel}"
                                               Foreground="{DynamicResource InkSubBrush}" />
                                    <TextBlock Style="{StaticResource InfoDot}"
                                               ToolTip="停下输入多久后才开始搜索结果列表；0 = 每个按键立即搜索。条目多时建议 80–150ms。搜索框与已输入的字符永远即时，不受此值影响。" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="FileIndexCard" Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="启用" Style="{StaticResource RowLabel}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource InfoDot}"
                                                   ToolTip="开启后可在搜索框用 /s 关键词 检索本地文件与已安装应用；普通搜索不查本地、不建索引。首次输入 /s 时后台建立索引；以后可点搜索框右侧刷新图标或按 Ctrl+Enter 重建。默认索引桌面、文档、图片、下载、开始菜单及固定磁盘的浅层目录；要检索更深的其他目录，请在下方添加索引文件夹。" />
                                        <CheckBox x:Name="FileSearchSwitch" Style="{StaticResource Switch}"
                                                  Margin="10,0,0,0" Click="OnFileSearchToggled" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="FileIndexStatus" Style="{StaticResource Hint}" Margin="2,8,0,2" />

                                <StackPanel x:Name="RootRows" Margin="0,4,0,0" />
                                <Button x:Name="AddRootButton" Content="＋ 添加文件夹…" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Left" Padding="0,4" Margin="2,4,0,0" Click="OnAddRoot" />

                                <Grid Margin="2,10,0,0">
                                    <TextBlock Text="索引条目上限" Style="{StaticResource RowLabel}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox x:Name="FileLimitBox" Width="90" TextAlignment="Right" FontSize="12"
                                                 Padding="6,3" VerticalContentAlignment="Center"
                                                 Background="{DynamicResource HoverBrush}"
                                                 Foreground="{DynamicResource InkBrush}"
                                                 BorderBrush="{DynamicResource CardBorderBrush}" />
                                        <TextBlock Text=" 条（0 = 不限制）" Style="{StaticResource Hint}"
                                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                                        <TextBlock Style="{StaticResource InfoDot}"
                                                   ToolTip="所有目录合计的索引条数上限；0 = 不限制。索引只是路径文本（约每条 0.4 KB，十万条约 40 MB）。改动在下次重建索引时生效。" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="FileExtCard" Style="{StaticResource Card}" Margin="0,0,0,10"
                                HorizontalAlignment="Stretch" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="文件类型白名单" Style="{StaticResource Section}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,10"
                                           Text="只索引列出的文件扩展名；文件夹和已安装应用不受影响。每行一个扩展名，行首 # 表示注释。修改后重建索引生效。" />
                                <TextBox x:Name="FileExtBox" AcceptsReturn="True" Height="420" MinHeight="320"
                                         HorizontalAlignment="Stretch" FontSize="12.5"
                                         Padding="10,8" VerticalScrollBarVisibility="Auto"
                                         Background="{DynamicResource HoverBrush}"
                                         Foreground="{DynamicResource InkBrush}"
                                         BorderBrush="{DynamicResource CardBorderBrush}" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="ExcludeCard" Style="{StaticResource Card}" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="排除文件夹（黑名单）" Style="{StaticResource Section}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,8"
                                           Text="索引会跳过这些目录及其子目录。可以添加环境变量路径（如 %ALLUSERSPROFILE%），也可以直接选择文件夹；更改后立即重建索引。" />
                                <StackPanel x:Name="ExcludeRows" Margin="0,2,0,0" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="添加变量路径" Style="{StaticResource ActionButton}"
                                            Click="OnAddExcludeVariable" />
                                    <Button Grid.Column="2" Content="选择文件夹…" Style="{StaticResource ActionButton}"
                                            Click="OnAddExcludeFolder" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="EngineCard" Style="{StaticResource Card}" Margin="0" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="搜索跳转" Style="{StaticResource Section}" />
                                    <TextBlock Style="{StaticResource InfoDot}" HorizontalAlignment="Right"
                                               ToolTip="为每条规则设置显示名称和 URL 模板。模板必须包含 {input}，搜索词会自动进行 URL 编码；输入普通关键词后，匹配跳转会出现在结果列表末尾。" />
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,8"
                                           Text="每条规则可独立启用、编辑名称和 URL 模板。搜索词以 {input} 替换并自动编码，例如京东可用 https://search.jd.com/Search?keyword={input}。" />
                                <Border Background="{DynamicResource HoverBrush}" CornerRadius="10"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        Padding="6">
                                    <StackPanel x:Name="EngineRows" />
                                </Border>
                                <Button Content="＋ 添加搜索跳转" Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Stretch" Margin="0,10,0,0"
                                        Click="OnAddSearchJump" />
                            </StackPanel>
                        </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
