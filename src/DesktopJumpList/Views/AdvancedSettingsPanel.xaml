<UserControl x:Class="DesktopJumpList.Views.AdvancedSettingsPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        Foreground="{DynamicResource InkBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <!-- The app-wide scrollbar is a 4px hairline that all but disappears on the card grey,
             which reads as "this list cannot scroll". Inside these panels the bar is wider, more
             opaque, and inset by 2px so it never sits on top of a row's「移除」link. -->
        <Style x:Key="PanelScrollBar" TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="9" />
            <Setter Property="MinWidth" Value="9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="4" Margin="2,0" Opacity="0.9"
                                                    Background="{DynamicResource InkFaintBrush}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PanelScrollBar}" />
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 详情面板：不再使用圆角卡片背景，只保留分组间距。 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkSubBrush}" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ThinSlider" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource PanelOpaqueBrush}"
                                                         Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Small ⓘ next to a row: the explanation lives in its ToolTip. -->
        <Style x:Key="InfoDot" TargetType="TextBlock">
            <Setter Property="Text" Value="ⓘ" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        </Style>
        <!-- Dark rounded tooltips matching the panel instead of the yellow system ones. -->
        <Style TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource PanelOpaqueBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="12,9" MaxWidth="380">
                            <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel x:Name="ModuleRoot">
        <StackPanel x:Name="ModuleStack">
                        <Border x:Name="DebounceCard" Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="输入防抖" Style="{StaticResource RowLabel}" />
                                <Slider x:Name="DebounceSlider" Grid.Column="1" Margin="12,0"
                                        Style="{StaticResource ThinSlider}" Minimum="0" Maximum="300" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock x:Name="DebounceValue" Width="56"
                                               TextAlignment="Right" Style="{StaticResource RowLabel}"
                                               Foreground="{DynamicResource InkSubBrush}" />
                                    <TextBlock Style="{StaticResource InfoDot}"
                                               ToolTip="停下输入多久后才开始搜索结果列表；0 = 每个按键立即搜索。条目多时建议 80–150ms。搜索框与已输入的字符永远即时，不受此值影响。" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="FileIndexCard" Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="启用" Style="{StaticResource RowLabel}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource InfoDot}"
                                                   ToolTip="开启后可在搜索框用 /s 关键词 检索本地文件与已安装应用。索引不会自动建立：点这里的 ⟳ 或搜索框右侧的 ⟳（Ctrl+Enter）手动重建。默认索引桌面、文档、图片、下载、开始菜单及固定磁盘的浅层目录；要检索更深的其他目录，请在下方添加索引文件夹。" />
                                        <!-- Manual rebuild, immediately left of the enable switch. -->
                                        <Button x:Name="SettingsRebuildButton" Style="{StaticResource LinkButton}"
                                                Margin="8,0,2,0" Padding="5,3" VerticalAlignment="Center"
                                                ToolTip="手动重建本地索引" Click="OnSettingsRebuildIndex">
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Button>
                                        <CheckBox x:Name="FileSearchSwitch" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center" Click="OnFileSearchToggled" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="普通搜索也检索本地文件" Style="{StaticResource RowLabel}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource InfoDot}"
                                                   ToolTip="开启后不用输入 /s：普通搜索结果先显示面板内的快捷项，下面用一条分割线隔开，再显示本地文件的命中项。索引仍需手动重建，不会因为输入而自动开始。" />
                                        <CheckBox x:Name="PlainFileSearchSwitch" Style="{StaticResource Switch}"
                                                  Margin="10,0,0,0" VerticalAlignment="Center"
                                                  Click="OnPlainFileSearchToggled" />
                                    </StackPanel>
                                </Grid>

                                <!-- 全局（全量）搜索的触发门槛：不到这个长度就不检索本地文件，
                                     到了才扫整个索引。结构照「索引条目上限」那一行来：输入框 → 单位 → ⓘ 结尾。 -->
                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="全局搜索触发字符数" Style="{StaticResource RowLabel}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <!-- 高 22：和上下几行的开关同高，行距才不会被这一行撑开 -->
                                        <TextBox x:Name="PlainFileMinCharsBox" Width="46" Height="22" TextAlignment="Center"
                                                 FontSize="12" Padding="4,1" VerticalContentAlignment="Center"
                                                 Background="{DynamicResource HoverBrush}"
                                                 Foreground="{DynamicResource InkBrush}"
                                                 BorderBrush="{DynamicResource CardBorderBrush}"
                                                 LostFocus="OnPlainFileMinCharsChanged"
                                                 KeyDown="OnPlainFileMinCharsKey" />
                                        <TextBlock Text=" 字符" Style="{StaticResource Hint}"
                                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                                        <TextBlock Style="{StaticResource InfoDot}"
                                                   ToolTip="普通搜索（不写 /s）输入到这个长度才开始检索本地文件；不足这个长度时列表里不出现「本地文件」一段，并在没有其它命中时提示还差几个字符。默认 3。/s 是手写的，直接从第一个字符开始检索，不带关键词时按最近修改排序。" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="注册表应用搜索" Style="{StaticResource RowLabel}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource InfoDot}"
                                                   ToolTip="从注册表的卸载信息（Uninstall）索引已安装的软件，任何窗口、任何盘符组合下都能搜到并直接启动，不受文件夹黑名单影响。安装/卸载软件时自动监听更新索引。" />
                                        <CheckBox x:Name="RegistrySearchSwitch" Style="{StaticResource Switch}"
                                                  Margin="10,0,0,0" VerticalAlignment="Center"
                                                  Click="OnRegistrySearchToggled" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="FileIndexStatus" Style="{StaticResource Hint}" Margin="2,8,0,2" />

                                <StackPanel x:Name="RootRows" Margin="0,4,0,0" />
                                <Button x:Name="AddRootButton" Content="＋ 添加文件夹…" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Left" Padding="0,4" Margin="2,4,0,0" Click="OnAddRoot" />

                                <Grid Margin="2,10,0,0">
                                    <TextBlock Text="索引条目上限" Style="{StaticResource RowLabel}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox x:Name="FileLimitBox" Width="90" TextAlignment="Right" FontSize="12"
                                                 Padding="6,3" VerticalContentAlignment="Center"
                                                 Background="{DynamicResource HoverBrush}"
                                                 Foreground="{DynamicResource InkBrush}"
                                                 BorderBrush="{DynamicResource CardBorderBrush}" />
                                        <TextBlock Text=" 条（0 = 不限制）" Style="{StaticResource Hint}"
                                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                                        <TextBlock Style="{StaticResource InfoDot}"
                                                   ToolTip="所有目录合计的索引条数上限；0 = 不限制。索引只是路径文本（约每条 0.4 KB，十万条约 40 MB）。改动在下次重建索引时生效。" />
                                    </StackPanel>
                                </Grid>

                                <!-- 索引数据：标题 + 表头 + 分隔线 + 列表，没有外层圆角容器。
                                     整块挂 Tag="ScrollZone"：非控件区域若被判成标题栏(HTCAPTION)，
                                     Windows 会直接吞掉鼠标滚轮，任何 WPF 处理器都收不到。 -->
                                <StackPanel x:Name="IndexStatsHost" Tag="ScrollZone" Margin="0,16,10,0">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="索引数据" Style="{StaticResource RowLabel}" FontSize="12" />
                                            <TextBlock x:Name="IndexStatsStatus" Style="{StaticResource Hint}"
                                                       Margin="1,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <Button x:Name="StatsAscButton" Content="数量 ↑"
                                                    Style="{StaticResource ActionButton}" MinWidth="66" MinHeight="28"
                                                    Padding="8,3" Margin="0,0,6,0"
                                                    ToolTip="按文件数量从少到多排序"
                                                    Click="OnSortStatsAscending" />
                                            <Button x:Name="StatsDescButton" Content="数量 ↓"
                                                    Style="{StaticResource ActionButton}" MinWidth="66" MinHeight="28"
                                                    Padding="8,3" ToolTip="按文件数量从多到少排序"
                                                    Click="OnSortStatsDescending" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="2,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="26" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="扩展名" Style="{StaticResource Hint}" />
                                        <TextBlock Grid.Column="1" Text="文件数量" Style="{StaticResource Hint}"
                                                   TextAlignment="Right" />
                                    </Grid>
                                    <Border Height="1" Margin="0,4,0,0" Background="{DynamicResource CardBorderBrush}"
                                            Opacity="0.6" />
                                    <ScrollViewer x:Name="IndexStatsScroller" Tag="ScrollZone" MaxHeight="360"
                                                  Focusable="False" Margin="0,2,0,0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="IndexStatsRows" Margin="0,0,6,0" />
                                    </ScrollViewer>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="FileExtCard" Style="{StaticResource Card}" Margin="0,0,0,10"
                                HorizontalAlignment="Stretch" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="文件类型白名单" Style="{StaticResource Section}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,10"
                                           Text="只索引列出的文件扩展名；文件夹和已安装应用不受影响。每行一个扩展名，行首 # 表示注释。修改后重建索引生效。" />
                                <TextBox x:Name="FileExtBox" AcceptsReturn="True" Height="420" MinHeight="320"
                                         HorizontalAlignment="Stretch" FontSize="12.5"
                                         Padding="10,8" VerticalScrollBarVisibility="Auto"
                                         Background="{DynamicResource HoverBrush}"
                                         Foreground="{DynamicResource InkBrush}"
                                         BorderBrush="{DynamicResource CardBorderBrush}" />
                                <Button Content="恢复默认白名单规则" Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Stretch" Margin="0,10,0,0"
                                        Click="OnResetFileExtensions" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="ExcludeCard" Style="{StaticResource Card}" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="排除文件夹 / 文件名（黑名单）" Style="{StaticResource Section}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,8"
                                           Text="条目可以是文件夹路径（支持 %环境变量%，整棵子树都不索引）、文件名（如 thumbs.db，全盘同名项都排除），也可以是通配符，例如 *.bak、~$*、*\cache\*。更改在下次手动重建索引时生效。" />
                                <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,8"
                                           Text="内置默认只排三类：系统目录（Windows、Program Files、ProgramData、回收站、卷信息、Windows 更新残留、错误报告）、系统日志（名字为 log / logs 的目录）、缓存（名字带 cache / thumb / emoji 的目录，以及 Temp / tmp）。你的文档、项目目录和依赖目录都不受影响。始终生效的还有：以 ~$ 开头的 Office 临时文件、以 . 开头的名字、带「隐藏」或「系统」属性的文件与文件夹。" />
                                <!-- 同结构：筛选 + 分隔线 + 列表 -->
                                <StackPanel x:Name="ExcludeHost" Tag="ScrollZone" Margin="2,10,10,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="筛选" Style="{StaticResource Hint}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox x:Name="ExcludeFilterBox" Grid.Column="1" FontSize="11.5"
                                                 Padding="6,4" VerticalContentAlignment="Center"
                                                 Background="{DynamicResource PanelOpaqueBrush}"
                                                 Foreground="{DynamicResource InkBrush}"
                                                 BorderBrush="{DynamicResource CardBorderBrush}"
                                                 ToolTip="模糊筛选排除项：按字符顺序匹配，空格分隔多个条件" />
                                    </Grid>
                                    <Border Height="1" Margin="0,8,0,0" Background="{DynamicResource CardBorderBrush}"
                                            Opacity="0.6" />
                                    <ScrollViewer x:Name="ExcludeScroller" Tag="ScrollZone" MaxHeight="360"
                                                  Focusable="False" Margin="0,2,0,0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="ExcludeRows" Margin="0,0,6,0" />
                                    </ScrollViewer>
                                    <TextBlock x:Name="ExcludeFilterEmpty" Style="{StaticResource Hint}"
                                               Margin="2,4,0,0" Visibility="Collapsed"
                                               Text="没有匹配的排除项。" />
                                </StackPanel>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="添加路径 / 通配符" Style="{StaticResource ActionButton}"
                                            Click="OnAddExcludeVariable" />
                                    <Button Grid.Column="2" Content="选择文件夹…" Style="{StaticResource ActionButton}"
                                            Click="OnAddExcludeFolder" />
                                </Grid>
                                <Button Content="恢复默认黑名单规则" Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                        Click="OnResetExcludes" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="EngineCard" Style="{StaticResource Card}" Margin="0" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="搜索跳转" Style="{StaticResource Section}" />
                                    <TextBlock Style="{StaticResource InfoDot}" HorizontalAlignment="Right"
                                               ToolTip="为每条规则设置显示名称和 URL 模板。模板必须包含 {input}，搜索词会自动进行 URL 编码；输入普通关键词后，匹配的跳转会作为一条「跳转」行排在磁贴结果之后、应用与本地文件之前。" />
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,8"
                                           Text="每条规则可独立启用、编辑名称和 URL 模板。搜索词以 {input} 替换并自动编码，例如京东可用 https://search.jd.com/Search?keyword={input}。" />
                                <Border x:Name="EngineHost" Tag="ScrollZone" Background="{DynamicResource HoverBrush}"
                                        CornerRadius="10"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        Padding="6">
                                    <StackPanel>
                                        <Grid Margin="4,2,4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="筛选" Style="{StaticResource Hint}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox x:Name="EngineFilterBox" Grid.Column="1" FontSize="11.5"
                                                     Padding="6,4" VerticalContentAlignment="Center"
                                                     Background="{DynamicResource PanelOpaqueBrush}"
                                                     Foreground="{DynamicResource InkBrush}"
                                                     BorderBrush="{DynamicResource CardBorderBrush}"
                                                     ToolTip="模糊筛选跳转规则：匹配名称与 URL 模板，按字符顺序匹配，空格分隔多个条件" />
                                        </Grid>
                                        <ScrollViewer x:Name="EngineScroller" Tag="ScrollZone" MaxHeight="440" Focusable="False"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="EngineRows" Margin="0,0,8,0" />
                                        </ScrollViewer>
                                        <TextBlock x:Name="EngineFilterEmpty" Style="{StaticResource Hint}"
                                                   Margin="4,4,0,0" Visibility="Collapsed"
                                                   Text="没有匹配的跳转规则。" />
                                    </StackPanel>
                                </Border>
                                <Button Content="＋ 添加搜索跳转" Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Stretch" Margin="0,10,0,0"
                                        Click="OnAddSearchJump" />
                            </StackPanel>
                        </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
