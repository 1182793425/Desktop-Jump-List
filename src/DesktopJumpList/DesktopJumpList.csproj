<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- app.manifest keeps per-monitor v2 DPI for the WPF windows; WFAC010 is a WinForms-only hint. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Jump</AssemblyName>
    <RootNamespace>DesktopJumpList</RootNamespace>
    <AssemblyTitle>Jump</AssemblyTitle>
    <Product>Jump · Desktop Jump List</Product>
    <!-- Version single-sourced from the repo-root .env ([App] APP_VERSION=...) so the
         assembly and the Inno Setup installer can never drift apart. Bump the version
         ONLY in .env; the build fails loudly if that file is missing. -->
    <RepoEnvFile>$(MSBuildThisFileDirectory)..\..\.env</RepoEnvFile>
    <Version Condition="Exists('$(RepoEnvFile)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(RepoEnvFile)')), '(?m)^APP_VERSION=([0-9][0-9.]*)').Value.Replace('APP_VERSION=','').Trim())</Version>
    <!-- Index structure version, same single-source rule: bump INDEX_VERSION in .env whenever
         the on-disk row format or its meaning changes. The app compares it with the stored index
         and rebuilds automatically when the stored one is older (or missing). -->
    <IndexVersion Condition="Exists('$(RepoEnvFile)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(RepoEnvFile)')), '(?m)^INDEX_VERSION=([0-9]+)').Value.Replace('INDEX_VERSION=','').Trim())</IndexVersion>
    <IndexVersion Condition="'$(IndexVersion)' == ''">0</IndexVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <!-- Surfaces INDEX_VERSION to the runtime: AssemblyMetadata("IndexVersion", "1"). -->
    <AssemblyMetadata Include="IndexVersion" Value="$(IndexVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- Onboarding artwork: real panel screenshots rendered by the preview hook. -->
    <Resource Include="Assets\onboarding-*.png" />
  </ItemGroup>

  <!-- UseWindowsForms adds System.Drawing / System.Windows.Forms to implicit usings, which
       collide with WPF's Color/Brush/Point/Application types in every file. Keep the
       WinForms types available through explicit usings in the tray icon only. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TinyPinyin.Net" Version="1.0.2" />
  </ItemGroup>

  <!-- Fail fast instead of silently building 0.0.0 when the version source is gone. -->
  <Target Name="RequireEnvVersion" BeforeTargets="BeforeBuild" Condition="!Exists('$(RepoEnvFile)')">
    <Error Text="Missing version source file: $(RepoEnvFile). The .env ([App] APP_VERSION) at the repo root is the single version source for the csproj and the installer." />
  </Target>

</Project>
