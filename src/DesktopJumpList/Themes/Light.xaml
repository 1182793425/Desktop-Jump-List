<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="CanvasColor">#FFF3F5F9</Color>
  <Color x:Key="InkColor">#FF141821</Color>
  <Color x:Key="InkSecondaryColor">#FF5C6472</Color>
  <Color x:Key="InkTertiaryColor">#FF98A0AD</Color>
  <Color x:Key="LineColor">#FFE7EAF0</Color>
  <Color x:Key="LineStrongColor">#FFD7DCE6</Color>
  <Color x:Key="AccentColor">#FF2F63E8</Color>
  <Color x:Key="AccentDeepColor">#FF1F4DC4</Color>
  <Color x:Key="AccentSoftColor">#FFE8EEFE</Color>
  <Color x:Key="VioletColor">#FF7A5CFF</Color>
  <Color x:Key="CoralColor">#FFFF7A59</Color>
  <Color x:Key="TealColor">#FF0FAF9F</Color>
  <Color x:Key="AmberColor">#FFF0A33A</Color>
  <Color x:Key="SuccessColor">#FF12A67A</Color>
  <Color x:Key="DangerColor">#FFE24C4C</Color>

  <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFF2F4F8" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FFE9EDF5" />
  <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="CardHoverBrush" Color="#FFFBFCFE" />
  <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="InkSecondaryBrush" Color="{StaticResource InkSecondaryColor}" />
  <SolidColorBrush x:Key="InkTertiaryBrush" Color="{StaticResource InkTertiaryColor}" />
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrongColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeepColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
  <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}" />
  <SolidColorBrush x:Key="CoralBrush" Color="{StaticResource CoralColor}" />
  <SolidColorBrush x:Key="TealBrush" Color="{StaticResource TealColor}" />
  <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="ScrimBrush" Color="#E6101828" />
  <SolidColorBrush x:Key="AccentOnBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="PanelBorderBrush" Color="#FFE9EDF4" />
  <SolidColorBrush x:Key="PanelHighlightBrush" Color="#B3FFFFFF" />
  <SolidColorBrush x:Key="InputBrush" Color="#FFF2F4F8" />
  <SolidColorBrush x:Key="InputFocusBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#8CC9D0DC" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#CCADB6C5" />
  <SolidColorBrush x:Key="SelectionRingBrush" Color="#FF2F63E8" />
  <SolidColorBrush x:Key="FolderInkBrush" Color="#FF2F63E8" />
  <SolidColorBrush x:Key="FolderTintBrush" Color="#163567F0" />
  <SolidColorBrush x:Key="FileInkBrush" Color="#FF6B4BEA" />
  <SolidColorBrush x:Key="FileTintBrush" Color="#167A5CFF" />
  <SolidColorBrush x:Key="AppInkBrush" Color="#FF0B9487" />
  <SolidColorBrush x:Key="AppTintBrush" Color="#140FAF9F" />
  <SolidColorBrush x:Key="UrlInkBrush" Color="#FFEE633F" />
  <SolidColorBrush x:Key="UrlTintBrush" Color="#16FF7A59" />
  <SolidColorBrush x:Key="OverlayCardBrush" Color="#FFFEFFFF" />
  <SolidColorBrush x:Key="ToastBrush" Color="#F01A1F29" />
  <SolidColorBrush x:Key="ToastInkBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="ToastActionBrush" Color="#24FFFFFF" />

  <LinearGradientBrush x:Key="PanelGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FFFFFFFF" Offset="0" />
    <GradientStop Color="#FFF7F9FD" Offset="0.55" />
    <GradientStop Color="#FFF2F5FB" Offset="1" />
  </LinearGradientBrush>

  <RadialGradientBrush x:Key="PanelGlowBrush" Center="0.88,0.02" GradientOrigin="0.88,0.02" RadiusX="1.1" RadiusY="0.9">
    <GradientStop Color="#243D74FF" Offset="0" />
    <GradientStop Color="#0A7A5CFF" Offset="0.42" />
    <GradientStop Color="#00FFFFFF" Offset="0.75" />
  </RadialGradientBrush>

  <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF3D74FF" Offset="0" />
    <GradientStop Color="#FF7A5CFF" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF356BF2" Offset="0" />
    <GradientStop Color="#FF6E5BF6" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF3D74FF" Offset="0" />
    <GradientStop Color="#FF8A5CFF" Offset="1" />
  </LinearGradientBrush>
</ResourceDictionary>
