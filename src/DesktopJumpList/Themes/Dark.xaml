<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="CanvasColor">#FF0D0F14</Color>
  <Color x:Key="InkColor">#FFF3F5FA</Color>
  <Color x:Key="InkSecondaryColor">#FFA5ADBB</Color>
  <Color x:Key="InkTertiaryColor">#FF6D7684</Color>
  <Color x:Key="LineColor">#FF2C323D</Color>
  <Color x:Key="LineStrongColor">#FF3A4150</Color>
  <Color x:Key="AccentColor">#FF7EA2FF</Color>
  <Color x:Key="AccentDeepColor">#FF5B87FF</Color>
  <Color x:Key="AccentSoftColor">#FF223152</Color>
  <Color x:Key="VioletColor">#FFA98BFF</Color>
  <Color x:Key="CoralColor">#FFFF9275</Color>
  <Color x:Key="TealColor">#FF3FD3C3</Color>
  <Color x:Key="AmberColor">#FFF2B45A</Color>
  <Color x:Key="SuccessColor">#FF3ED3A0</Color>
  <Color x:Key="DangerColor">#FFFF6B6B</Color>

  <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1D222B" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF252B36" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FF2D3441" />
  <SolidColorBrush x:Key="CardBrush" Color="#FF1E232C" />
  <SolidColorBrush x:Key="CardHoverBrush" Color="#FF252B36" />
  <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="InkSecondaryBrush" Color="{StaticResource InkSecondaryColor}" />
  <SolidColorBrush x:Key="InkTertiaryBrush" Color="{StaticResource InkTertiaryColor}" />
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrongColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeepColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
  <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}" />
  <SolidColorBrush x:Key="CoralBrush" Color="{StaticResource CoralColor}" />
  <SolidColorBrush x:Key="TealBrush" Color="{StaticResource TealColor}" />
  <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="ScrimBrush" Color="#F007090D" />
  <SolidColorBrush x:Key="AccentOnBrush" Color="#FF101522" />
  <SolidColorBrush x:Key="PanelBorderBrush" Color="#26FFFFFF" />
  <SolidColorBrush x:Key="PanelHighlightBrush" Color="#26FFFFFF" />
  <SolidColorBrush x:Key="InputBrush" Color="#FF252B36" />
  <SolidColorBrush x:Key="InputFocusBrush" Color="#FF2A313D" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#99556072" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#CC6B7890" />
  <SolidColorBrush x:Key="SelectionRingBrush" Color="#FF7EA2FF" />
  <SolidColorBrush x:Key="FolderInkBrush" Color="#FF8FB4FF" />
  <SolidColorBrush x:Key="FolderTintBrush" Color="#2E4C7DFF" />
  <SolidColorBrush x:Key="FileInkBrush" Color="#FFBCA6FF" />
  <SolidColorBrush x:Key="FileTintBrush" Color="#2E9A7CFF" />
  <SolidColorBrush x:Key="AppInkBrush" Color="#FF63E3D5" />
  <SolidColorBrush x:Key="AppTintBrush" Color="#2E2FC8B8" />
  <SolidColorBrush x:Key="UrlInkBrush" Color="#FFFFA68B" />
  <SolidColorBrush x:Key="UrlTintBrush" Color="#2EFF8D6D" />
  <SolidColorBrush x:Key="OverlayCardBrush" Color="#FF1B2029" />
  <SolidColorBrush x:Key="ToastBrush" Color="#F0E9EDF5" />
  <SolidColorBrush x:Key="ToastInkBrush" Color="#FF151A22" />
  <SolidColorBrush x:Key="ToastActionBrush" Color="#1A151A22" />

  <LinearGradientBrush x:Key="PanelGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF1C212A" Offset="0" />
    <GradientStop Color="#FF171B22" Offset="0.55" />
    <GradientStop Color="#FF14181F" Offset="1" />
  </LinearGradientBrush>

  <RadialGradientBrush x:Key="PanelGlowBrush" Center="0.86,0.0" GradientOrigin="0.86,0.0" RadiusX="1.15" RadiusY="0.95">
    <GradientStop Color="#3D4C7DFF" Offset="0" />
    <GradientStop Color="#149A7CFF" Offset="0.4" />
    <GradientStop Color="#00FFFFFF" Offset="0.76" />
  </RadialGradientBrush>

  <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF5B8CFF" Offset="0" />
    <GradientStop Color="#FFA27BFF" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF5B8CFF" Offset="0" />
    <GradientStop Color="#FF9A72FF" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF5B8CFF" Offset="0" />
    <GradientStop Color="#FFA97BFF" Offset="1" />
  </LinearGradientBrush>
</ResourceDictionary>
