<Application x:Class="DesktopJumpList.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <Color x:Key="SurfaceColor">#F91B1D2A</Color>
    <Color x:Key="SurfaceRaisedColor">#FF252838</Color>
    <Color x:Key="AccentColor">#FF8B7CFF</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF5F4FF" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFACADBE" />
    <Style x:Key="RoundIconButton" TargetType="Button">
      <Setter Property="Background" Value="#19FFFFFF" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="17">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#35FFFFFF" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX=".92" ScaleY=".92" /></Setter.Value></Setter></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
