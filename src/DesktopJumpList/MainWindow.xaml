<Window x:Class="DesktopJumpList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DesktopJumpList.Views"
        Title="Jump — 快捷启动"
        Width="52" Height="52"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" Opacity="0" Foreground="{DynamicResource InkBrush}"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <DropShadowEffect x:Key="PanelShadow" BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.26" Color="#FF0A1322" />
  </Window.Resources>

  <Grid x:Name="Root" Background="Transparent" MouseLeftButtonDown="Root_MouseLeftButtonDown">
    <Grid x:Name="PanelHost" Width="100" Height="44" Visibility="Collapsed"
          HorizontalAlignment="Center" VerticalAlignment="Center">
      <views:LauncherPanel x:Name="Panel" Effect="{StaticResource PanelShadow}" />
      <Path x:Name="MorphGlyph" Data="M13.6 2.6 L5.4 13.5 L10.6 13.5 L9.6 21.4 L18.6 10.5 L13.4 10.5 Z"
            Fill="White" Width="21" Height="21" Stretch="Uniform" Opacity="0" IsHitTestVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <Path.Effect>
          <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.2" Color="#FF1A1440" />
        </Path.Effect>
      </Path>
    </Grid>

    <Border x:Name="DockHalo" Width="48" Height="48" CornerRadius="17" Background="#103D74FF"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Opacity="0.12"
            HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
      <Border.RenderTransform>
        <ScaleTransform x:Name="DockHaloScale" ScaleX="1" ScaleY="1" />
      </Border.RenderTransform>
    </Border>

    <Border x:Name="Dock" Width="40" Height="40" CornerRadius="13" Cursor="Hand"
            Background="{DynamicResource BrandGradientBrush}"
            PreviewMouseLeftButtonDown="Dock_MouseLeftButtonDown"
            PreviewMouseMove="Dock_MouseMove"
            PreviewMouseLeftButtonUp="Dock_MouseLeftButtonUp"
            LostMouseCapture="Dock_LostMouseCapture"
            ToolTip="按住拖动 · 单击打开">
      <Border.RenderTransform>
        <ScaleTransform x:Name="DockScale" ScaleX="1" ScaleY="1" />
      </Border.RenderTransform>
      <Grid>
        <Border CornerRadius="13">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1">
              <GradientStop Color="#3DFFFFFF" Offset="0" />
              <GradientStop Color="#0AFFFFFF" Offset="0.52" />
              <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Border CornerRadius="13" BorderBrush="#30FFFFFF" BorderThickness="1" />
        <Path Data="M13.6 2.6 L5.4 13.5 L10.6 13.5 L9.6 21.4 L18.6 10.5 L13.4 10.5 Z" Fill="White"
              Width="19" Height="19" Stretch="Uniform" IsHitTestVisible="False">
          <Path.Effect>
            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.2" Color="#FF1A1440" />
          </Path.Effect>
        </Path>
      </Grid>
    </Border>
  </Grid>
</Window>
