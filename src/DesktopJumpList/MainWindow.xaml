<Window x:Class="DesktopJumpList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DesktopJumpList.Views"
        Title="Jump — 快捷启动"
        Width="60" Height="60"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" Opacity="0" Foreground="{DynamicResource InkBrush}"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <DropShadowEffect x:Key="PanelShadow" BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.26" Color="#FF0A1322" />
  </Window.Resources>

  <Grid x:Name="Root" Background="Transparent">
    <Grid x:Name="PanelHost" Margin="32" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <ScaleTransform x:Name="PanelScale" ScaleX="1" ScaleY="1" />
      </Grid.RenderTransform>
      <views:LauncherPanel x:Name="Panel" Effect="{StaticResource PanelShadow}" />
    </Grid>

    <Border x:Name="Dock" Width="60" Height="60" CornerRadius="20" Cursor="Hand"
            Background="{DynamicResource BrandGradientBrush}"
            PreviewMouseLeftButtonDown="Dock_MouseLeftButtonDown"
            PreviewMouseMove="Dock_MouseMove"
            PreviewMouseLeftButtonUp="Dock_MouseLeftButtonUp"
            LostMouseCapture="Dock_LostMouseCapture"
            ToolTip="按住拖动 · 单击打开">
      <Border.RenderTransform>
        <ScaleTransform x:Name="DockScale" ScaleX="1" ScaleY="1" />
      </Border.RenderTransform>
      <Border.Style>
        <Style TargetType="{x:Type Border}">
          <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Cursor" Value="Hand" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Border CornerRadius="20" BorderBrush="#2EFFFFFF" BorderThickness="1" />
        <Ellipse Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,4,0,0"
                 IsHitTestVisible="False">
          <Ellipse.Fill>
            <RadialGradientBrush Center="0.3,0.25" GradientOrigin="0.3,0.25" RadiusX="0.8" RadiusY="0.8">
              <GradientStop Color="#52FFFFFF" Offset="0" />
              <GradientStop Color="#00FFFFFF" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Path Data="M13.6 2.6 L5.4 13.5 L10.6 13.5 L9.6 21.4 L18.6 10.5 L13.4 10.5 Z" Fill="White"
              Width="27" Height="27" Stretch="Uniform" IsHitTestVisible="False">
          <Path.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.22" Color="#FF1A1440" />
          </Path.Effect>
        </Path>
        <Border Width="14" Height="2.5" CornerRadius="1.25" Background="#42FFFFFF" VerticalAlignment="Bottom"
                Margin="0,0,0,7" IsHitTestVisible="False" />
      </Grid>
    </Border>
  </Grid>
</Window>
