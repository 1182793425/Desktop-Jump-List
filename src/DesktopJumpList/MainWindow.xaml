<Window x:Class="DesktopJumpList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Desktop Jump List" Width="360" Height="600"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" Deactivated="Window_Deactivated"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <Window.Resources>
    <Style x:Key="ShortcutButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Padding="10" CornerRadius="13" Background="{TemplateBinding Background}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#1EFFFFFF" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="#32FFFFFF" /><Setter TargetName="Root" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX=".98" ScaleY=".98" /></Setter.Value></Setter></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="RootGrid">
    <Border x:Name="Panel" Background="{StaticResource SurfaceBrush}" CornerRadius="22" Opacity="0"
            Visibility="Collapsed" MouseLeftButtonDown="Panel_MouseLeftButtonDown">
      <Border.Effect>
        <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity=".35" Color="#FF000000" />
      </Border.Effect>
      <Grid Margin="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="4,2,4,14">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentBrush}">
              <TextBlock Text="⌁" FontSize="21" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="快捷启动" Foreground="{StaticResource PrimaryTextBrush}" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="Desktop Jump List" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="1" Style="{StaticResource RoundIconButton}" Content="×" FontSize="20" Click="ClosePanel_Click" />
        </Grid>
        <Grid Grid.Row="1" Margin="4,0,4,12">
          <Border Background="#18FFFFFF" CornerRadius="12" Height="38">
            <Grid>
              <TextBlock Text="⌕" Foreground="{StaticResource SecondaryTextBrush}" FontSize="21" Margin="12,0,0,2" VerticalAlignment="Center" />
              <TextBox x:Name="SearchBox" Margin="39,0,10,0" Background="Transparent" BorderThickness="0"
                       Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" VerticalContentAlignment="Center"
                       TextChanged="SearchBox_TextChanged" ToolTip="搜索快捷项" />
            </Grid>
          </Border>
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
          <ItemsControl x:Name="ShortcutList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="4,0,4,4">
                  <Button Style="{StaticResource ShortcutButton}" Click="OpenShortcut_Click" Tag="{Binding}">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                      <Border Width="38" Height="38" CornerRadius="12" Background="#1DFFFFFF">
                        <TextBlock Text="{Binding Glyph}" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Group}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" Margin="0,2,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="›" FontSize="22" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                  </Button>
                  <Button Style="{StaticResource RoundIconButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Content="⋮" FontSize="15" Tag="{Binding}" Click="ShortcutMenu_Click" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Button Grid.Row="3" Height="44" BorderThickness="0" Cursor="Hand" Click="AddShortcut_Click">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="AddRoot" Background="{StaticResource AccentBrush}" CornerRadius="13">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="+" FontSize="20" Foreground="White" Margin="0,0,7,1" />
                  <TextBlock Text="添加快捷项" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="AddRoot" Property="Opacity" Value=".87" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </Grid>
    </Border>
    <Button x:Name="Orb" Width="58" Height="58" HorizontalAlignment="Right" VerticalAlignment="Top"
            Click="Orb_Click" Cursor="Hand" BorderThickness="0" Background="Transparent"
            PreviewMouseLeftButtonDown="Orb_MouseLeftButtonDown" PreviewMouseMove="Orb_MouseMove" PreviewMouseLeftButtonUp="Orb_MouseLeftButtonUp">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <Border x:Name="OrbRoot" CornerRadius="29" Background="{StaticResource AccentBrush}">
            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity=".38" Color="#FF3E2CB7" /></Border.Effect>
            <TextBlock Text="⌁" Foreground="White" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="OrbRoot" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.08" ScaleY="1.08" /></Setter.Value></Setter></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="OrbRoot" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX=".94" ScaleY=".94" /></Setter.Value></Setter></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Button.Template>
    </Button>
  </Grid>
</Window>
