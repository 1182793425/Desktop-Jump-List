# Jump 版本号唯一来源（single source of truth）。
# 引用方：
#   - src/DesktopJumpList/DesktopJumpList.csproj（正则读取，[App] 行不影响解析）
#   - installer/DesktopJumpList.iss（ISPP ReadIni，依赖 [App] 段头）
# 升版本只改这一处；tag 与 Release 资产名（Jump-<版本>-setup.exe）都取自它。
[App]
APP_VERSION=3.14.37

# 本地索引结构版本。**只要 index.bin 的行格式/含义发生变化就必须 +1**，
# 版本不一致（或旧索引里没有这个字段）时，程序会在启动后自动重建索引。
# 与 APP_VERSION 无关：功能升级通常不动它。
INDEX_VERSION=2
